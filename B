ruluyor (Bu işlem biraz sürebilir)...\")\n\n# Temel kütüphaneler\nos.system(\"pip install -q fire omegaconf jaxtyping typeguard pymeshlab trimesh pygltflib xatlas scikit-image opencv-python-headless onnxruntime hf_transfer 2>&1 | tail -1\")\nos.system(\"pip install -q 'numpy==2.1.3' 'scipy==1.14.1' 'numba==0.61.0' 'rembg==2.0.62' 2>&1 | tail -1\")\n\n# pytorch3d (3D işleme için zorunlu)\nif os.system(\"python -c 'import pytorch3d' 2>/dev/null\") != 0:\n    import torch\n    TV = torch.__version__.split('+')[0]\n    CV = torch.version.cuda.replace('.', '') if torch.cuda.is_available() else 'cpu'\n    os.system(f\"pip install -q pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py313_cu{CV}_pyt{TV}/download.html 2>&1 | tail -1\")\n    if os.system(\"python -c 'import pytorch3d' 2>/dev/null\") != 0:\n        os.system(\"pip install -q 'git+https://github.com/facebookresearch/pytorch3d.git@stable' 2>&1 | tail -1\")\n\n# nvdiffrast (Mesh projeksiyonu için zorunlu)\nif os.system(\"python -c 'import nvdiffrast.torch' 2>/dev/null\") != 0:\n    os.system(\"pip install -q setuptools==69.5.1 wheel ninja 2>&1 | tail -1\")\n    os.system(\"pip install -q git+https://github.com/NVlabs/nvdiffrast.git --no-build-isolation 2>&1 | tail -1\")\n\n# torch_scatter (Bellek yönetimi için)\nif os.system(\"python -c 'import torch_scatter' 2>/dev/null\") != 0:\n    import torch\n    TV = torch.__version__.split('+')[0]\n    CT = \"cpu\" if not torch.cuda.is_available() else f\"cu{torch.version.cuda.replace('.', '')}\"\n    os.system(f\"pip install -q torch-scatter -f https://data.pyg.org/whl/torch-{TV}+{CT}.html 2>&1 | tail -1\")\n\n# ── 3) MODELLERİN İNDİRİLMESİ (DİSK DOSTU) ──\nprint(\"📥 3/6: Modeller indiriliyor ve doğru klasöre yerleştiriliyor...\")\n\n# Ana modeller\nif not os.path.exists(\"ckpt/img2mvimg/unet/config.json\"):\n    from huggingface_hub import snapshot_download\n    try:\n        snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", local_