"-q\",\n    \"fire\", \"rembg\", \"onnxruntime\", \"trimesh\", \"einops\", \"omegaconf\",\n    \"huggingface_hub\", \"gradio\", \"gradio-client\", \"pydantic\", \"jaxtyping\", \"typeguard\",\n    \"imageio\", \"scikit-image\", \"opencv-python-headless\", \"matplotlib\", \"plyfile\", \"pymeshlab\",\n    \"diffusers==0.27.2\", \"transformers==4.39.3\", \"peft==0.10.0\", \"accelerate==0.28.0\"\n])\n\nimport torch\nif torch.cuda.is_available(): torch.cuda.empty_cache()\n\nprint(\"=== [4/8] nvdiffrast ve PyTorch3D Derleniyor ===\")\ntry:\n    import nvdiffrast\nexcept ImportError:\n    os.chdir(WORK_DIR)\n    shutil.rmtree(\"nvdiffrast\", ignore_errors=True)\n    subprocess.run([\"git\", \"clone\", \"https://github.com/NVlabs/nvdiffrast.git\"], check=True)\n    os.chdir(\"nvdiffrast\")\n    res = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--no-build-isolation\", \".\"], capture_output=True, text=True)\n    if res.returncode != 0:\n        site_pkg = [p for p in sys.path if \"dist-packages\" in p or \"site-packages\" in p][0]\n        shutil.copytree(\"nvdiffrast\", os.path.join(site_pkg, \"nvdiffrast\"), dirs_exist_ok=True)\n    os.chdir(WORK_DIR)\n\ntry:\n    import pytorch3d\nexcept ImportError:\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--no-build-isolation\", \"git+https://github.com/facebookresearch/pytorch3d.git\"])\n\nos.chdir(u3d_dir)\n\nprint(\"=== [5/8] Model Ağırlıkları İndiriliyor ===\")\nfrom huggingface_hub import snapshot_download\nif not os.path.exists(\"ckpt/img2mvimg/unet/config.json\"):\n    snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\nimg2mvimg_yolu = f\"{u3d_dir}/ckpt/img2mvimg\"\nunet_4ch_yolu = f\"{u3d_dir}/ckpt/unet_4ch\"\nif os.path.exists(img2mvimg_yolu):\n    shutil.rmtree(unet_4ch_yolu, ignore_errors=True)\n    os.makedirs(unet_4ch_yolu + \"/unet\", exist_ok=True)\n    ana_cfg = json.loads(open(img2mvimg_yolu + \"/unet/config.json\", \"r\").read())\n    ana_cfg[\"in_channels\"] = 4\n    ana_cfg.pop(\"num_class_embeds\", None)\n    ana_cfg[\"addition_embed_type\"] = None\n    open(unet_4ch_yolu + \"/unet/config.json\", \"w\").write(json.dumps(ana_cfg, indent=2))\n    for d in os.listdir(img2mvimg_yolu):\n        if d != \"unet\": os.symlink(img2mvimg_yolu + \"/\" + d, unet_4ch_yolu + \"/\" + d)\n    for d in os.listdir(img2mvimg_yolu + \"/unet\"):\n        if d != \"config.json\": os.symlink(img2mvimg_yolu + \"/unet/\" + d, unet_4ch_yolu + \"/unet/\" + d)\n\nprint(\"=== [6/8] PyTorch, Rembg ve Arayüz Yamaları Uygulanıyor ===\")\n# PyTorch weights_only Yaması\napp_path = os.path.join(u3d_dir, \"gradio_app.py\")\nif os.path.exists(app_path):\n    acode = open(app_path, \"r\", encoding=\"utf-8\").read()\n    if \"_old_load = torch.load\" not in acode:\n        acode = \"import torch\\n_old_load = torch.load\\ntorch.load = lambda *a, **k: _old_load(*a, **{**k, 'weights_only': False})\\n\" + acode\n    open(app_path, \"w\", encoding=\"utf-8\").write(acode)\n\n# Gradio Type Fix\ntry:\n    import gradio_client.utils as client_utils\n    utils_path = client_utils.__file__\n    code_client = open(utils_path, \"r\", encoding=\"utf-8\").read()\n    code_client = code_client.replace(\"def get_type(schema):\", \"def get_type(schema):\\n    if not isinstance(schema, dict): return 'Any'\")\n    code_client = code_client.replace(\"def _json_schema_to_python_type(schema, defs):\", \"def _json_schema_to_python_type(schema, defs):\\n    if not isinstance(schema, dict): return 'Any'\")\n    open(utils_path, \"w\", encoding=\"utf-8\").write(code_client)\nexcept Exception: pass\n\n# Path ve MeshLab yamaları\nfor root, _, files in os.walk(u3d_dir):\n    for file in files:\n        if file.endswith(\".py\"):\n            path = os.path.join(root, file)\n            txt = open(path, \"r\", errors=\"ignore\").read()\n            ntxt = txt.replace(\"C:\\\\\\\\Users\\\\\\\\admin\\\\\\\\Desktop\\\\\\\\Unique3D\\\\\\\\\", \"\")\n            ntxt = ntxt.replace(\"RasterizeGLContext\", \"RasterizeCudaContext\")\n            ntxt = ntxt.replace(\"output_db=False,\", \"\").replace(\", output_db=False\", \"\").replace(\"output_db=False\", \"\")\n            ntxt = ntxt.replace(\"pymeshlab.PercentageValue\", \"pymeshlab.PureValue\").replace(\"pymeshlab.Percentage\", \"pymeshlab.PureValue\")\n            if txt != ntxt: open(path, \"w\", encoding=\"utf-8\").write(ntxt)\n\n# Normal Prediction ve Recon\nnorm_p = os.path.join(u3d_dir, \"app/custom_models/normal_prediction.py\")\nif os.path.exists(norm_p):\n    open(norm_p, \"w\", encoding=\"utf-8\").write(open(norm_p, \"r\", encoding=\"utf-8\").read().replace(\"ckpt/img2mvimg\", \"ckpt/unet_4ch\").replace(\"ckpt/normal\", \"ckpt/unet_4ch\"))\n\nrecon_path = os.path.join(u3d_dir, \"mesh_reconstruction/recon.py\")\nif os.path.exists(recon_path):\n    code_recon = open(recon_path, \"r\", encoding=\"utf-8\").read()\n    code_recon = code_recon.replace(\"res=512\", \"res=256\").replace(\"resolution=512\", \"resolution=256\").replace(\"512,\", \"256,\").replace(\"512)\", \"256)\")\n    if \"torch.cuda.empty_cache()\" not in code_recon: code_recon = \"import gc, torch\\n\" + code_recon + \"\\ngc.collect()\\ntorch.cuda.empty_cache()\\n\"\n    open(recon_path, \"w\", encoding=\"utf-8\").write(code_recon)\n\n# Rembg tuple (CPUExecutionProvider) hatasını çözen GÜVENLİ yama\nutils_p = os.path.join(u3d_dir, \"scripts/utils.py\")\nif os.path.exists(utils_p):\n    utils_code = open(utils_p, \"r\", encoding=\"utf-8\").read()\n    utils_code = re.sub(r'providers\\s*=\\s*\\[.*?\\]', 'providers = [\"CPUExecutionProvider\"]', utils_code, flags=re.DOTALL)\n    open(utils_p, \"w\", encoding=\"utf-8\").write(utils_code)\n\n# 2D Stüdyo Arayüzü Eklemesi\npatch_path = os.path.join(u3d_dir, \"studio_2d_patch.py\")\nstudio_2d_lines = [\n    \"import os, sys, gc, time, random, shutil, torch, rembg, huggingface_hub\",\n    \"huggingface_hub.cached_download = huggingface_hub.hf_hub_download\",\n    \"import gradio as gr\",\n    \"from diffusers import AutoPipelineForText2Image\",\n    \"def _get_rembg_session():\",\n    \"    from scripts.utils import session as _s\",\n    \"    return _s\",\n    \"def uret_2d_gorsel(prompt, neg_prompt, steps, cfg, bg_sil):\",\n    \"    if not prompt or not prompt.strip(): return None, '⚠️ Lütfen İngilizce nesne tarifi yazın'\",\n    \"    try:\",\n    \"        gc.collect()\",\n    \"        torch.cuda.empty_cache()\",\n    \"        Moved = []\",\n    \"        for m_adi in ['app.custom_models.mvimg_prediction', 'app.custom_models.normal_prediction']:\",\n    \"            mod = sys.modules.get(m_adi)\",\n    \"            if mod and hasattr(mod, 'pipeline') and hasattr(mod.pipeline, 'unet'):\",\n    \"                try: mod.pipeline.unet.to('cpu'); Moved.append(mod.pipeline.unet)\",\n    \"                except Exception: pass\",\n    \"        gc.collect(); torch.cuda.empty_cache()\",\n    \"        pipe = AutoPipelineForText2Image.from_pretrained('stabilityai/sdxl-turbo', torch_dtype=torch.float16, variant='fp16', low_cpu_mem_usage=True).to('cuda')\",\n    \"        seed = random.randint(1, 99999999)\",\n    \"        gen = torch.Generator(device='cuda').manual_seed(seed)\",\n    \"        with torch.inference_mode(): img = pipe(prompt=prompt + ', isometric, front view, centered, clean background, high detail', negative_prompt=neg_prompt, num_inference_steps=int(steps), guidance_scale=float(cfg), generator=gen).images[0]\",\n    \"        del pipe, gen; gc.collect(); torch.cuda.empty_cache()\",\n    \"        for u in Moved:\",\n    \"            try: u.to('cuda')\",\n    \"            except Exception: pass\",\n    \"        if bg_sil: img = rembg.remove(img, session=_get_rembg_session())\",\n    f\"        kayit_yolu = f'{WORK_DIR}/uretilen_2d_gorseller/gorsel_{{int(time.time())}}_{{seed}}.png'\",\n    \"        img.save(kayit_yolu)\",\n    \"        return img, f'✅ Başarılı -> {kayit_yolu}'\",\n    \"    except Exception as e: return None, f'❌ Hata: {str(e)}'\",\n    \"def sadece_arkaplan_sil(img):\",\n    \"    if img is None: return None, '⚠️ Görsel yüklenmedi'\",\n    \"    try:\",\n    \"        out = rembg.remove(img, session=_get_rembg_session())\",\n    f\"        kayit_yolu = f'{WORK_DIR}/uretilen_2d_gorseller/temiz_{{int(time.time())}}.png'\",\n    \"        out.save(kayit_yolu)\",\n    \"        return out, f'✅ Arka plan silindi -> {kayit_yolu}'\",\n    \"    except Exception as e: return None, f'❌ Hata: {str(e)}'\",\n    \"def create_2d_tab():\",\n    \"    with gr.Tab('🎨 2D Görsel Üret & Hazırla'):\",\n    \"        gr.Markdown('### 1. Metinden 3D Uyumlu 2D Nesne Üret veya Arka Planını Sil')\",\n    \"        with gr.Row():\",\n    \"            with gr.Column():\",\n    \"                prompt_in = gr.Textbox(label='2D Nesne Tarifi', placeholder='Örn: a wooden medieval shield')\",\n    \"                neg_in = gr.Textbox(label='Negatif Prompt', value='blurry, cropped, low quality')\",\n    \"                with gr.Row(): steps_in = gr.Slider(1, 8, value=4, step=1, label='Adım'); cfg_in = gr.Slider(0.0, 3.0, value=0.0, step=0.5, label='CFG')\",\n    \"                bg_chk = gr.Checkbox(value=True, label='Otomatik Arka Plan Sil'); btn_uret = gr.Button('🎨 2D Görsel Üret', variant='primary')\",\n    \"                gr.Markdown('---'); yukle_in = gr.Image(type='pil', label='Kendi Fotoğrafını Yükle'); btn_sil = gr.Button('✂️ Sadece Arka Planı Sil')\",\n    \"            with gr.Column():\",\n    \"                out_img = gr.Image(type='pil', label='Hazırlanan Görsel'); out_path = gr.Textbox(label='Kayıt Yolu', interactive=False)\",\n    \"        btn_uret.click(uret_2d_gorsel, inputs=[prompt_in, neg_in, steps_in, cfg_in, bg_chk], outputs=[out_img, out_path])\",\n    \"        btn_sil.click(sadece_arkaplan_sil, inputs=[yukle_in], outputs=[out_img, out_path])\"\n]\nopen(patch_path, \"w\