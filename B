xt += \"\\n\\ndef rotate_normals_torch(normals, rotation):\\n    return normals\\n\"\n\nif \"session =\" not in utxt:\n    utxt += \"\\nimport rembg\\ntry:\\n    session = rembg.new_session(providers=['CPUExecutionProvider'])\\nexcept Exception:\\n    session = rembg.new_session()\\n\"\n\nopen(utils_p, \"w\", encoding=\"utf-8\").write(utxt)\n\n# --- DİNAMİK KANAL UYUM YAMASI (app/custom_models/utils.py) ---\nmodel_utils_p = os.path.join(u3d_dir, \"app/custom_models/utils.py\")\nif os.path.exists(model_utils_p):\n    m_code = open(model_utils_p, \"r\", encoding=\"utf-8\").read()\n    dynamic_patch = \"\"\"\n        # --- Dinamik Kanal Uyum Yaması ---\n        for key in ['conv_in.weight', 'ref_unet.conv_in.weight']:\n            if key in state_dict:\n                ckpt_weight = state_dict[key]\n                model_weight_shape = configurable_unet.unet.state_dict()[key].shape\n                if ckpt_weight.shape != model_weight_shape:\n                    if ckpt_weight.shape[1] > model_weight_shape[1]:\n                        state_dict[key] = ckpt_weight[:, :model_weight_shape[1], :, :]\n                    elif ckpt_weight.shape[1] < model_weight_shape[1]:\n                        pad_size = model_weight_shape[1] - ckpt_weight.shape[1]\n                        padding = torch.zeros((ckpt_weight.shape[0], pad_size, ckpt_weight.shape[2], ckpt_weight.shape[3]), dtype=ckpt_weight.dtype, device=ckpt_weight.device)\n                        state_dict[key] = torch.cat([ckpt_weight, padding], dim=1)\n        # ---------------------------------\n        configurable_unet.unet.load_state_dict(state_dict, strict=False)\n    \"\"\"\n    if \"configurable_unet.unet.load_state_dict(state_dict, strict=False)\" in m_code:\n        m_code = m_code.replace(\"configurable_unet.unet.load_state_dict(state_dict, strict=False)\", dynamic_patch)\n        open(model_utils_p, \"w\", encoding=\"utf-8\").write(m_code)\n\nrecon_path = os.path.join(u3d_dir, \"mesh_reconstruction/recon.py