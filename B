2\n    )\n    print(\"✅ Tüm model ağırlıkları eksiksiz başarıyla indirildi.\")\nexcept Exception as e:\n    print(\"❌ İndirme Hatası:\", e)\n\"\"\"\nwith open(\"dl_weights.py\", \"w\", encoding=\"utf-8\") as f:\n    f.write(dl_script)\nos.system(f\"{sys.executable} dl_weights.py\")\n\nprint(\"\\n🧹 3/5: Model Konfigürasyonları Onarılıyor...\")\nfor cfg_path, ch in [(\"ckpt/img2mvimg/unet/config.json\", 8), (\"ckpt/unet_4ch/unet/config.json\", 4)]:\n    if os.path.exists(cfg_path):\n        with open(cfg_path, \"r\", encoding=\"utf-8\") as f: cfg = json.load(f)\n        cfg[\"in_channels\"] = ch\n        cfg.pop(\"num_class_embeds\", None)\n        cfg[\"addition_embed_type\"] = None\n        with open(cfg_path, \"w\", encoding=\"utf-8\") as f: f.write(json.dumps(cfg, indent=2))\n\nprint(\"\\n🩹 4/5: VRAM, Pipeline ve Cihaz Atama Yamaları Uygulanıyor...\")\nfor root, dirs, files in os.walk(\".\"):\n    for file in files:\n        if file.endswith(('.py', '.yaml', '.yml', '.json', '.txt')):\n            filepath = os.path.join(root, file)\n            try:\n                with open(filepath, \"r\", encoding=\"utf-8\") as f:\n                    content = f.read()\n                \n                modified = False\n                \n                if 'revision=\"v2.0\"' in content or \"revision='v2.0'\" in content:\n                    content = re.sub(r',\\s*revision\\s*=\\s*[\"\\']v2\\.0[\"\\']', '', content)\n                    modified = True\n                if 'revision: \"v2.0\"' in content or \"revision: 'v2.0'\" in content or \"revision: v2.0\" in content:\n                    content = re.sub(r'\\s*revision:\\s*[\"\\']?v2\\.0[\"\\']?', '', content)\n                    modified = True\n                    \n                if \"lambdalabs/sd-image-variations-diffusers\" in content:\n                    content = content.replace(\"lambdalabs/sd-image-variations-diffusers\", \"runwayml/stable-diffusion-v1-5\")\n                    modified = True\n                if \"lambda/sd-image-variations-diffusers\" in content:\n                    content = content.replace(\"lambda/sd-image-variations-diffusers\", \"runwayml/stable-diffusion-v1-5\")\n                    modified = True\n\n                if modified:\n                    with open(filepath, \"w\", encoding=\"utf-8\") as f:\n                        f.write(content)\n            except Exception:\n                pass\n\nsd_zoo_path = \"scripts/sd_model_zoo.py\"\nif os.path.exists(sd_zoo_path):\n    with open(sd_zoo_path, \"r\", encoding=\"utf-8\") as f: z_code = f.read()\n    z_code = re.sub(r'^([ \\t]*)pipe\\s*=\\s*pipe\\.to\\([\"\\']cuda[\"\\']\\)', r'\\1try: pipe = pipe.to(\"cuda\")\\n\\1except Exception: pass', z_code, flags=re.MULTILINE)\n    z_code = z_code.replace('device_map=\"auto\"', 'device_map=\"balanced\"').replace(\"device_map='auto'\", \"device_map='balanced'\")\n    with open(sd_zoo_path, \"w\", encoding=\"utf-8\") as f: f.write(z_code)\n\nmvi_path = \"scripts/multiview_inference.py\"\nif os.path.exists(mvi_path):\n    with open(mvi_path, \"r\", encoding=\"utf-8\") as f: mvi_code = f.read()\n    mvi_code = mvi_code.replace(\"(512, 512)\", \"(256, 256)\")\n    with open(mvi_path, \"w\", encoding=\"utf-8\") as f: f.write(mvi_code)\n\nutils_path = \"app/custom_models/utils.py\"\nif os.path.exists(utils_path):\n    with open(utils_path, \"r\", encoding=\"utf-8\") as f: u_code = f.read()\n    patch = r\"\\1try:\\1    if hasattr(pipeline, 'enable_model_cpu_offload'): pipeline.enable_model_cpu_offload()\\1    if hasattr(pipeline, 'enable_attention_slicing'): pipeline.enable_attention_slicing(1)\\1except: pass\\1return pipeline\"\n    u_code = re.sub(r\"(\\n[ \\t]+)return pipeline\", patch, u_code)\n    with open(utils_path, \"w\", encoding=\"utf-8\") as f: f.write(u_code)\n\nnorm_path = \"app/custom_models/normal_prediction.py\"\nif os.path.exists(norm_path):\n    with open(norm_path, \"r\", encoding=\"utf-8\") as f: norm_code = f.read()\n    patch2 = r\"\\1import gc, torch; gc.collect(); torch.cuda.empty_cache()\\1images = trainer.pipeline_forward(\"\n    norm_code = re.sub(r\"(\\n[ \\t]+)images = trainer\\.pipeline_forward\\(\", patch2, norm_code)\n    with open(norm_path, \"w\", encoding=\"utf-8\") as f: f.write(norm_code)\n\nutils2_path = \"scripts/utils.py\"\nif os.path.exists(utils2_path):\n    with open(utils2_path, \"r\", encoding=\"utf-8\") as f: u2_code = f.read()\n    u2_code = u2_code.replace(\"providers=providers\", \"providers=['CUDAExecutionProvider', 'CPUExecutionProvider']\")\n    with open(utils2_path, \"w\", encoding=\"utf-8\") as f: f.write(u2_code)\n\ngen_path = \"app/gradio_3dgen.py\"\nif os.path.exists(gen_path):\n    with open(gen_path, \"r\", encoding=\"utf-8\") as f: content = f.read()\n    content = re.sub(r\",\\s*show_share_button\\s*=\\s*(True|False)\", \"\", content)\n    content = re.sub(r\"show_share_button\\s*=\\s*(True|False)\\s*,\\s*\", \"\", content)\n    with open(gen_path, \"w\", encoding=\"utf-8\") as f: f.write(content)\n\nif os.path.exists(\"gradio_app.py\"):\n    with open(\"gradio_app.py\", \"r\", encoding=\"utf-8\") as f: gc_code = f.read()\n    patches = \"\"\"\nimport huggingface_hub as _hf\nif not hasattr(_hf, 'cached_download'):\n    _hf.cached_download = _hf.hf_hub_download\n\nimport torch\n_old_load = torch.load\ndef _safe_load(*args, **kwargs):\n    kwargs['weights_only'] = False\n    return _old_load(*args, **kwargs)\ntorch.load = _safe_load\n\nimport diffusers, importlib, pkgutil\ntry:\n    import custum_3d_diffusion.custum_pipeline as cp_pkg\n    for _, modname, _ in pkgutil.walk_packages(cp_pkg.__path__, cp_pkg.__name__ + \".\"):\n        try:\n            mod = importlib.import_module(modname)\n            for k, v in mod.__dict__.items():\n                if isinstance(v, type):\n                    setattr(diffusers, k, v)\n        except Exception:\n            pass\nexcept Exception as e:\n    pass\n\n# device_map=\"auto\" hatasını kesin olarak yakalayıp balanced yapan evrensel yama\nif hasattr(diffusers, 'ModelMixin') and hasattr(diffusers.ModelMixin, 'from_pretrained'):\n    pass\n\n_old_pipeline_from_pretrained = getattr(diffusers.DiffusionPipeline, 'from_pretrained', None)\nif _old_pipeline_from_pretrained:\n    def _safe_pipeline_from_pretrained(*args, **kwargs):\n        if kwargs.get(\"device_map\") == \"auto\":\n            kwargs[\"device_map\"] = \"balanced\"\n        return _old_pipeline_from_pretrained(*args, **kwargs)\n    diffusers.DiffusionPipeline.from_pretrained = _safe_pipeline_from_pretrained\n\n_old_model_from_pretrained = getattr(diffusers.ModelMixin, 'from_pretrained', None)\nif _old_model_from_pretrained:\n    def _safe_model_from_pretrained(*args, **kwargs):\n        if kwargs.get(\"device_map\") == \"auto\":\n            kwargs[\"device_map\"] = \"balanced\"\n        return _old_model_from_pretrained(*args, **kwargs)\n    diffusers.ModelMixin.from_pretrained = _safe_model_from_pretrained\n\nif hasattr(diffusers.DiffusionPipeline, 'to'):\n    _old_pipe_to = diffusers.DiffusionPipeline.to\n    def _safe_pipe_to(self, *args, **kwargs):\n        try:\n            return _old_pipe_to(self, *args, **kwargs)\n        except Exception:\n            return self\n    diffusers.DiffusionPipeline.to = _safe_pipe_to\n\nimport transformers\nif hasattr(transformers, 'CLIPVisionModelWithProjection'):\n    _old_clip_from_pretrained = transformers.CLIPVisionModelWithProjection.from_pretrained\n    def _safe_clip_from_pretrained(pretrained_model_name_or_path, *args, **kwargs):\n        try:\n            return _old_clip_from_pretrained(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            kw = dict(kwargs)\n            kw.pop(\"subfolder\", None)\n            return _old_clip_from_pretrained(\"openai/clip-vit-large-patch14\", *args, **kw)\n    transformers.CLIPVisionModelWithProjection.from_pretrained = _safe_clip_from_pretrained\n\nif hasattr(transformers, 'CLIPImageProcessor'