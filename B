figuration_utils as _cu\n_orig_load_config = _cu.ConfigMixin.load_config\n@classmethod\ndef _patched_load_config(cls, pretrained_model_name_or_path, return_unused_kwargs=False, return_commit_hash=False, **kwargs):\n    if isinstance(pretrained_model_name_or_path, str):\n        is_local = (pretrained_model_name_or_path.startswith(\"./\") or pretrained_model_name_or_path.startswith(\"/\") or (not pretrained_model_name_or_path.startswith(\"http\") and _os.path.isdir(pretrained_model_name_or_path)))\n        if is_local:\n            abs_path = _os.path.abspath(pretrained_model_name_or_path)\n            subfolder = kwargs.get(\"subfolder\", None) or \"\"\n            config_file = _os.path.join(abs_path, subfolder, cls.config_name) if subfolder else _os.path.join(abs_path, cls.config_name)\n            if not _os.path.isfile(config_file):\n                model_index = _os.path.join(abs_path, \"model_index.json\")\n                if _os.path.isfile(model_index):\n                    with open(model_index, \"r\") as f: config_dict = _json.load(f)\n                    # DÜZELTME: Tuple formatında döndür\n                    if return_unused_kwargs:\n                        if return_commit_hash: return config_dict, {}, None\n                        return config_dict, {}\n                    if return_commit_hash: return config_dict, None\n                    return config_dict\n                raise EnvironmentError(f\"Local file not found: {config_file}\")\n            with open(config_file, \"r\") as f: config_dict = _json.load(f)\n            if return_unused_kwargs:\n                if return_commit_hash: return config_dict, {}, None\n                return config_dict, {}\n            if return_commit_hash: return config_dict, None\n            return config_dict\n    return _orig_load_config.__func__(cls, pretrained_model_name_or_path, return_unused_kwargs=return_unused_kwargs, return_commit_hash=return_commit_hash, **kwargs)\n_cu.ConfigMixin.load_config = _patc