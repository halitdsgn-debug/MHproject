p=dropout_p, is_causal=is_causal, **kwargs)\n_F.scaled_dot_product_attention = _sliced_sdpa\ntorch.nn.functional.scaled_dot_product_attention = _sliced_sdpa\n\"\"\"\n# OOM yamasini bir metin blogu olarak yaz; ic ice Python string listelerinde yapistirma kaynakli girinti hatasi olusmasin.\ncompile(oom_patch_content, \"oom_patch.py\", \"exec\")\nwith open(\"oom_patch.py\", \"w\", encoding=\"utf-8\") as f:\n    f.write(oom_patch_content + \"\\n\")\n\nprint(\"   Python/YAML/JSON dosyalari filtrelenmis klasor taramasiyla aliniyor...\", flush=True)\n# Git ls-files kullanilmiyor; bazi Kaggle oturumlarinda bu komut bekleyebiliyor.\n# Buyuk agirlik klasorleri ve Git metadata'si os.walk'tan tamamen cikariliyor.\n_uzantilar = (\".py\", \".yaml\", \".yml\", \".json\")\n_atlanan_klasorler = {\".git\", \"ckpt\", \"__pycache__\", \".ipynb_checkpoints\", \".cache\", \"node_modules\"}\n_kod_dosyalari = []\n_taranan_klasor = 0","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T13:56:33.032298Z","iopub.execute_input":"2026-10-23T13:56:33.033155Z","iopub.status.idle":"2026-10-23T13:56:33.062425Z","shell.execute_reply.started":"2026-10-23T13:56:33.033123Z","shell.execute_reply":"2026-10-23T13:56:33.061362Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport sys\nimport json\nimport shutil\nimport subprocess\n\nprint(\"🟢 1. Kaggle Ortamı Hazırlanıyor...\")\nos.chdir('/kaggle/working')\n\n# Linux 3D Sürücülerini Yükle\nos.system(\"apt-get update -q && apt-get install -y -q libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev\")\n\n# Unique3D Deposunu Çek ve Temizle\nif not os.path.exists(\"Unique3D\"):\n    subprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\"], check=True)\nos.chdir('/kaggle/working/Unique3D')\nos.system(\"git reset --hard HEAD\") # Yamaları sıfırla (tekrar çalıştırmalara karşı emniyet)\n\nprint(\"🟢 2. Paketler ve Kütüphaneler Kuruluyor (Bu kısım birkaç dakika sürecek)...\")\nos.system(\"pip install -q ninja torch-scatter -f https://data.pyg.org/whl/torch-2.5.1+cu124.html\")\nos.system(\"pip install -q fire rembg onnxruntime-gpu trimesh pymeshlab einops omegaconf transformers==4.38.2 diffusers==0.27.2 peft==0.10.0 accelerate pydantic==2.8.2\")\nos.system(\"pip install -q -r requirements.txt\")\n\n# Pytorch3D ve Nvdiffrast (NVIDIA 3D Render Motoru)\ntry: import pytorch3d\nexcept ImportError: os.system('pip install -q \"git+https://github.com/facebookresearch/pytorch3d.git\"')\n\ntry: import nvdiffrast\nexcept ImportError:\n    os.system(\"rm -rf nvdiffrast_repo && git clone https://github.com/NVlabs/nvdiffrast.git nvdiffrast_repo\")\n    os.system(\"pip install -q ./nvdiffrast_repo --no-build-isolation\")\n\nprint(\"🟢 3. Model Ağırlıkları (ckpt) Kontrol Ediliyor...\")\nif not os.path.exists(\"ckpt/img2mvimg\"):\n    os.system(\"huggingface-cli download Wuvin/Unique3D --repo-type space --include 'ckpt/*' --local-dir .\")\n\nprint(\"🟢 4. 4 Kanallı UNet Köprüsü ve Parametre Düzeltmeleri Yapılıyor...\")\nimg2mvimg_yolu = \"/kaggle/working/Unique3D/ckpt/img2mvimg\"\nunet_4ch_yolu = \"/kaggle/working/Unique3D/ckpt/unet_4ch\"\nos.makedirs(os.path.join(unet_4ch_yolu, \"unet\"), exist_ok=True)\n\nif os.path.exists(img2mvimg_yolu):\n    # VAE ve yan bileşenleri bağla\n    for dosya in os.listdir(img2mvimg_yolu):\n        if dosya == \"unet\": continue\n        src, dst = os.path.join(img2mvimg_yolu, dosya), os.path.join(unet_4ch_yolu, dosya)\n        if not os.path.exists(dst):\n            if os.path.isdir(src): shutil.copytree(src, dst)\n            else: shutil.copy(src, dst)\n\n    # UNet ağırlıklarını bağla\n    src_unet_dir = os.path.join(img2mvimg_yolu, \"unet\")\n    for dosya in os.listdir(src_unet_dir):\n        if dosya != \"config.json\":\n            src, dst = os.path.join(src_unet_dir, dosya), os.path.join(unet_4ch_yolu, \"unet\", dosya)\n            if not os.path.exists(dst): os.symlink(src, dst)\n\n    # Config dosyasını 4 kanallı yap & class_labels hatasını kökten çöz\n    src_unet_cfg = os.path.join(src_unet_dir, \"config.json\")\n    if os.path.exists(src_unet_cfg):\n        with open(src_unet_cfg, \"r\", encoding=\"utf-8\") as f: cfg = json.load(f)\n        cfg[\"in_channels\"] = 4\n        if \"num_class_embeds\" in cfg: del cfg[\"num_class_embeds\"]\n        if \"addition_embed_type\" in cfg: cfg[\"addition_embed_type\"] = None\n        with open(os.path.join(unet_4ch_yolu, \"unet/config.json\"), \"w\", encoding=\"utf-8\") as f: json.dump(cfg, f, indent=2)\n\n# Harici 404 yollarını yerel dosyalara çevir\nfor kok, _, dosyalar in os.walk(\".\"):\n    for dosya in dosyalar:\n        if dosya.endswith((\".py\", \".yaml\", \".yml\", \".json\")):\n            yol = os.path.join(kok, dosya)\n            try:\n                with open(yol, \"r\", encoding=\"utf-8\") as f: c = f.read()\n                if \"lambdalabs/sd-image-variations-diffusers\" in c:\n                    c = c.replace(\"lambdalabs/sd-image-variations-diffusers\", img2mvimg_yolu)\n                    with open(yol, \"w\", encoding=\"utf-8\") as f: f.write(c)\n                if \"normal\" in dosya.lower() and img2mvimg_yolu in c:\n                    c = c.replace(img2mvimg_yolu, unet_4ch_yolu)\n                    with open(yol, \"w\", encoding=\"utf-8\") as f: f.write(c)\n            except Exception: pass\n\nprint(\"🟢 5. Sistem Uyumsuzluk ve Bellek (OOM) Yamaları Uygulanıyor...\")\n\n# Yama A: sd_model_zoo.py (device_map auto hatası çözümü)\nyol_zoo = \"scripts/sd_model_zoo.py\"\nif os.path.exists(yol_zoo):\n    with open(yol_zoo, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    k = k.replace('device_map=\"auto\"', '').replace(\"device_map='auto'\", \"\")\n    eski_satir = \"pipe = model_cls.from_pretrained(ckpt_or_pretrained, torch_dtype=torch_dtype, **kwargs)\"\n    yeni_satir = \"kwargs.pop('device_map', None); pipe = model_cls.from_pretrained(ckpt_or_pretrained, torch_dtype=torch_dtype, **kwargs)\"\n    with open(yol_zoo, \"w\", encoding=\"utf-8\") as f: f.write(k.replace(eski_satir, yeni_satir))\n\n# Yama B: unifield_processor.py (low_cpu_mem_usage ve tekrarlanan parametre çözümü)\nyol_proc = \"custum_3d_diffusion/custum_modules/unifield_processor.py\"\nif os.path.exists(yol_proc):\n    with open(yol_proc, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    k = k.replace('**unet_kwargs', \"**{k: v for k, v in unet_kwargs.items() if k != 'low_cpu_mem_usage'}, low_cpu_mem_usage=False\")\n    eski_ref = 'torch_dtype=self.unet.dtype'\n    yeni_ref = 'torch_dtype=self.unet.dtype, low_cpu_mem_usage=False, ignore_mismatched_sizes=True'\n    if yeni_ref not in k: k = k.replace(eski_ref, yeni_ref)\n    with open(yol_proc, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama C: utils.py (Meta tensör çökme sorunu CPU köprüsü)\nyol_utils = \"app/custom_models/utils.py\"\nif os.path.exists(yol_utils):\n    with open(yol_utils, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_load = \"configurable_unet.unet.load_state_dict(state_dict, strict=False)\"\n    yeni_load = \"\"\"try: configurable_unet.unet.to_empty(device=\"cpu\")\n    except Exception: pass\n    if 'conv_in.weight' in state_dict:\n        s1, s2 = state_dict['conv_in.weight'].shape, configurable_unet.unet.conv_in.weight.shape\n        if s1 != s2: configurable_unet.unet.conv_in = torch.nn.Conv2d(s1[1], s1[0], kernel_size=3, padding=1, device=torch.device(\"cpu\"), dtype=weight_dtype)\n    if hasattr(configurable_unet.unet, 'ref_unet') and 'ref_unet.conv_in.weight' in state_dict:\n        s1, s2 = state_dict['ref_unet.conv_in.weight'].shape, configurable_unet.unet.ref_unet.conv_in.weight.shape\n        if s1 != s2: configurable_unet.unet.ref_unet.conv_in = torch.nn.Conv2d(s1[1], s1[0], kernel_size=3, padding=1, device=torch.device(\"cpu\"), dtype=weight_dtype)\n    try: configurable_unet.unet.load_state_dict(state_dict, strict=False, assign=True)\n    except Exception: configurable_unet.unet.load_state_dict(state_dict, strict=False)\"\"\"\n    if eski_load in k: k = k.replace(eski_load, yeni_load)\n    \n    eski_to = \"configurable_unet.unet.to(device, dtype=weight_dtype)\"\n    yeni_to = \"\"\"try: configurable_unet.unet.to(device, dtype=weight_dtype)\n    except NotImplementedError:\n        configurable_unet.unet.to_empty(device=device)\n        configurable_unet.unet.to(device, dtype=weight_dtype)\"\"\"\n    if eski_to in k: k = k.replace(eski_to, yeni_to)\n    with open(yol_utils, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama D: OOM (Ekran Kartı Belleği) Temizleyicisi\nyol_multiview = \"scripts/multiview_inference.py\"\nif os.path.exists(yol_multiview):\n    with open(yol_multiview, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_kod = \"rm_normals = predict_normals([img.resize((512, 512), resample=Image.LANCZOS) for img in img_list], guidance_scale=1.5)\"\n    yeni_kod = \"import torch, gc; torch.cuda.empty_cache(); gc.collect(); rm_normals = predict_normals([img.resize((512, 512), resample=Image.LANCZOS) for img in img_list], guidance_scale=1.5)\"\n    if eski_kod in k: k = k.replace(eski_kod, yeni_kod)\n    with open(yol_multiview, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\nyol_app = \"app/gradio_3dgen.py\"\nif os.path.exists(yol_app):\n    with open(yol_app, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_kod = \"def generate3dv2(rgb_pils, front_pil, init_type, do_refine=True, expansion_weight=0.1):\"\n    yeni_kod = \"def generate3dv2(rgb_pils, front_pil, init_type, do_refine=True, expansion_weight=0.1):\\n    import torch, gc\\n    torch.cuda.empty_cache()\\n    gc.collect()\"\n    if eski_kod in k: k = k.replace(eski_kod, yeni_kod)\n    with open(yol_app, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama E: rembg CPU modu ve Gradio share linki\nyol_rembg = \"scripts/utils.py\"\nif os.path.exists(yol_rembg):\n    with open(yol_rembg, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    if \"providers=providers\" in k:\n        with open(yol_rembg, \"w\", encoding=\"utf-8\") as f: f.write(k.replace(\"providers=providers\", \"providers=['CPUExecutionProvider']\"))\n\nfor hedef in [\"gradio_app.py\", \"app/gradio_3dgen.py\"]:\n    if os.path.exists(hedef):\n        with open(hedef, \"r\", encoding=\"utf-8\") as f: k = f.read()\n        k = k.replace(\"show_share_button=True, \", \"\").replace(\", show_share_button=True\", \"\")\n        if \"share=True\" not in k: k = k.replace(\".launch(\", \".launch(share=True, \")\n        if \"cached_download\" not in k: k = \"import huggingface_hub\\nhuggingface_hub.cached_download = huggingface_hub.hf_hub_download\\n\" + k\n        with open(hedef, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\nprint(\"🚀 6. FÜZEYİ ATEŞLE! Unique3D Stüdyosu Başlatılıyor...\")\n!python gradio_app.py","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T14:24:55.362042Z","iopub.execute_input":"2026-10-23T14:24:55.362564Z","iopub.status.idle":"2026-10-23T14:25:36.273417Z","shell.execute_reply.started":"2026-10-23T14:24:55.362533Z","shell.execute_reply":"2026-10-23T14:25:36.272569Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, sys, shutil, subprocess, time, re, json, gc\n\n# Çalışma dizinini otomatik algıla (Kaggle veya Colab)\nWORK_DIR = \"/kaggle/working\" if os.path.exists(\"/kaggle/working\") else \"/content\"\nu3d_dir = f\"{WORK_DIR}/Unique3D\"\nos.chdir(WORK_DIR)\n\n# CUDA Derleme ve Bellek Optimizasyon Değişkenleri (T4 GPU = 7.5)\nos.environ[\"TORCH_CUDA_ARCH_LIST\"] = \"7.5;8.0;8.6\"\nos.environ[\"FORCE_CUDA\"] = \"1\"\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\nos.environ[\"PYOPENGL_PLATFORM\"] = \"egl\"\n\nprint(\"=== [1/9] Eski Süreçler ve Bellek Temizleniyor ===\")\nos.system(\"fuser -k 7860/tcp >/dev/null 2>&1\")\nos.system(\"pkill -9 -f gradio_app.py >/dev/null 2>&1\")\nos.system(\"pkill -9 -f cloudflared >/dev/null 2>&1\")\ngc.collect()\n\nos.makedirs(f\"{WORK_DIR}/uretilen_3d_modeller\", exist_ok=True)\nos.makedirs(f\"{WORK_DIR}/uretilen_2d_gorseller\", exist_ok=True)\n\nprint(\"=== [2/9] Linux Sistem ve OpenGL/EGL Derleme Paketleri Kuruluyor ===\")\nos.system(\"apt-get update -qq && apt-get install -y -qq libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev libglib2.0-0 build-essential ninja-build psmisc git wget >/dev/null 2>&1\")\nsubprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--upgrade\", \"pip\", \"ninja\", \"setuptools\", \"wheel\"])\n\nprint(\"=== [3/9] Unique3D Projesi ve Temel Python Paketleri Kuruluyor ===\")\nif not os.path.exists(os.path.join(u3d_dir, \".git\")):\n    shutil.rmtree(u3d_dir, ignore_errors=True)\n    subprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\", u3d_dir], check=True)\n\nsubprocess.check_call([\n    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n    \"fire\", \"rembg\", \"onnxruntime\", \"trimesh\", \"einops\", \"omegaconf\",\n    \"transformers\", \"diffusers\", \"peft\", \"accelerate\", \"huggingface_hub\",\n    \"gradio\", \"gradio-client\", \"pydantic\", \"jaxtyping\", \"typeguard\",\n    \"imageio\", \"scikit-image\", \"opencv-python-headless\", \"matplotlib\", \"plyfile\", \"pymeshlab\"\n])\n\nimport torch\nif torch.cuda.is_available():\n    torch.cuda.empty_cache()\n    torch.cuda.ipc_collect()\n\n# torch_scatter kurulumu\nprint(\"⚙️ torch-scatter kuruluyor...\")\ntry:\n    import torch_scatter\n    print(\"✅ torch-scatter zaten kurulu.\")\nexcept ImportError:\n    t_version = torch.__version__.split(\"+\")[0]\n    cuda_version = torch.version.cuda.replace(\".\", \"\") if torch.version.cuda else \"121\"\n    pyg_url = f\"https://data.pyg.org/whl/torch-{t_version}+cu{cuda_version}.html\"\n    res = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"torch-scatter\", \"-f\", pyg_url], capture_output=True, text=True)\n    if res.returncode != 0:\n        subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"torch-scatter\"], check=True)\n    print(\"✅ torch-scatter başarıyla kuruldu!\")\n\nprint(\"=== [4/9] nvdiffrast ve PyTorch3D Kuruluyor ===\")\ntry:\n    import nvdiffrast\n    print(\"✅ nvdiffrast zaten kurulu.\")\nexcept ImportError:\n    print(\"⚙️ nvdiffrast kuruluyor...\")\n    os.chdir(WORK_DIR)\n    shutil.rmtree(\"nvdiffrast\", ignore_errors=True)\n    subprocess.run([\"git\", \"clone\", \"https://github.com/NVlabs/nvdiffrast.git\"], check=True)\n    os.chdir(\"nvdiffrast\")\n    res = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--no-build-isolation\", \".\"], capture_output=True, text=True)\n    if res.returncode != 0:\n        print(\"⚠️ Standart C++ derlemesi atlandı, nvdiffrast JIT modunda kuruluyor...\")\n        site_pkg = [p for p in sys.path if \"dist-packages\" in p or \"site-packages\" in p][0]\n        shutil.copytree(\"nvdiffrast\", os.path.join(site_pkg, \"nvdiffrast\"), dirs_exist_ok=True)\n    os.chdir(WORK_DIR)\n    import nvdiffrast\n    print(\"✅ nvdiffrast başarıyla aktif edildi!\")\n\ntry:\n    import pytorch3d\n    print(\"✅ PyTorch3D zaten kurulu.\")\nexcept ImportError:\n    print(\"⚙️ PyTorch3D derlenip kuruluyor (2-3 dakika sürebilir)...\")\n    subprocess.check_call([\n        sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--no-build-isolation\",\n        \"git+https://github.com/facebookresearch/pytorch3d.git\"\n    ])\n    print(\"✅ PyTorch3D başarıyla kuruldu!\")\n\nos.chdir(u3d_dir)\n\nprint(\"=== [5/9] Model Ağırlıkları ve UNet Yapılandırması ===\")\nfrom huggingface_hub import snapshot_download\nif not (os.path.exists(\"ckpt/img2mvimg/unet/diffusion_pytorch_model.bin\") or os.path.exists(\"ckpt/img2mvimg/unet/diffusion_pytorch_model.safetensors\")):\n    print(\"📥 Unique3D model ağırlıkları indiriliyor...\")\n    snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\nimg2mvimg_yolu = f\"{u3d_dir}/ckpt/img2mvimg\"\nunet_4ch_yolu = f\"{u3d_dir}/ckpt/unet_4ch\"\nif os.path.exists(img2mvimg_yolu):\n    shutil.rmtree(unet_4ch_yolu, ignore_errors=True)\n    os.makedirs(unet_4ch_yolu + \"/unet\", exist_ok=True)\n    ana_cfg_path = img2mvimg_yolu + \"/unet/config.json\"\n    if os.path.exists(ana_cfg_path):\n        ana_cfg = json.loads(open(ana_cfg_path, \"r\").read())\n        ana_cfg[\"in_channels\"] = 4\n        ana_cfg.pop(\"num_class_embeds\", None)\n        ana_cfg[\"addition_embed_type\"] = None\n        open(unet_4ch_yolu + \"/unet/config.json\", \"w\").write(json.dumps(ana_cfg, indent=2))\n    for d in os.listdir(img2mvimg_yolu):\n        if d != \"unet\":\n            os.symlink(img2mvimg_yolu + \"/\" + d, unet_4ch_yolu + \"/\" + d)\n    for d in os.listdir(img2mvimg_yolu + \"/unet\"):\n        if d != \"config.json\":\n            os.symlink(img2mvimg_yolu + \"/unet/\" + d, unet_4ch_yolu + \"/unet/\" + d)\n\nprint(\"=== [6/9] Tüm Python 3.13, CUDA ve Bellek Yamaları Uygulanıyor ===\")\n\n# --- KESİN ÇÖZÜM: Tüm projede geçen device_map=\"auto\" ifadelerini temizle ---\nfor root, _, files in os.walk(u3d_dir):\n    for file in files:\n        if file.endswith((\".py\", \".json\", \".yaml\", \".yml\")):\n            path = os.path.join(root, file)\n            try:\n                txt = open(path, \"r\", errors=\"ignore\").read()\n                new_txt = txt\n                new_txt = new_txt.replace('device_map=\"auto\"', 'device_map=None')\n                new_txt = new_txt.replace(\"device_map='auto'\", \"device_map=None\")\n                new_txt = new_txt.replace(\"C:\\\\\\\\Users\\\\\\\\admin\\\\\\\\Desktop\\\\\\\\Unique3D\\\\\\\\\", \"\")\n                new_txt = new_txt.replace(\"RasterizeGLContext\", \"RasterizeCudaContext\")\n                new_txt = new_txt.replace(\"output_db=False,\", \"\").replace(\", output_db=False\", \"\").replace(\"output_db=False\", \"\")\n                new_txt = new_txt.replace(\"pymeshlab.PercentageValue\", \"pymeshlab.PureValue\").replace(\"pymeshlab.Percentage\", \"pymeshlab.PureValue\")\n                new_txt = new_txt.replace(\"lambdalabs/sd-image-variations-diffusers\", unet_4ch_yolu)\n                if \"torch.load(\" in new_txt and \"weights_only\" not in new_txt:\n                    new_txt = re.sub(r\"torch\\.load\\(([^)]+)\\)\", r\"torch.load(\\1, weights_only=False)\", new_txt)\n                if txt != new_txt:\n                    open(path, \"w\", encoding=\"utf-8\").write(new_txt)\n            except Exception:\n                pass\n\n# sd_model_zoo.py dosyasını temiz ve hatasız yazıyoruz\nsd_zoo_p = os.path.join(u3d_dir, \"scripts/sd_model_zoo.py\")\nclean_sd_zoo_code = '''\nimport torch\nfrom diffusers import StableDiffusionPipeline\n\ndef model_from_ckpt_or_pretrained(ckpt_or_pretrained, model_cls, original_config_file='ckpt/v1-inference.yaml', torch_dtype=torch.float16, **kwargs):\n    kwargs.pop('device_map', None)\n    return model_cls.from_pretrained(ckpt_or_pretrained, torch_dtype=torch_dtype, **kwargs)\n\ndef load_common_sd15_pipe(base_model, pipeline_class=StableDiffusionPipeline, **model_kwargs):\n    model_kwargs.pop('device_map', None)\n    return model_from_ckpt_or_pretrained(base_model, pipeline_class, torch_dtype=torch.float16, **model_kwargs)\n'''\nopen(sd_zoo_p, \"w\", encoding=\"utf-8\").write(clean_sd_zoo_code)\n\n# app/custom_models/utils.py içerisindeki state_dict yükleme kısmını hatasız düzelt\nmodel_utils_p = os.path.join(u3d_dir, \"app/custom_models/utils.py\")\nif os.path.exists(model_utils_p):\n    m_code = open(model_utils_p, \"r\", encoding=\"utf-8\").read()\n    # Eğer daha önce bozuk yama eklendiyse temizle, orijinal load_state_dict satırını koru\n    m_code = m_code.replace(\"configurable_unet.unet.load_state_dict(state_dict, strict=False)\", \"configurable_unet.unet.load_state_dict(state_dict, strict=False)\")\n    open(model_utils_p, \"w\", encoding=\"utf-8\").write(m_code)\n\nunifield_p = os.path.join(u3d_dir, \"custum_3d_diffusion/custum_modules/unifield_processor.py\")\nif os.path.exists(unifield_p):\n    utxt = open(unifield_p, \"r\", encoding=\"utf-8\").read()\n    if \"ignore_mismatched_sizes\" not in utxt:\n        utxt = utxt.replace(\n            \"subfolder=\\\"unet\\\", torch_dtype=self.weight_dtype,\",\n            \"subfolder=\\\"unet\\\", torch_dtype=self.weight_dtype, ignore_mismatched_sizes=True,\"\n        )\n        open(unifield_p, \"w\", encoding=\"utf-8\").write(utxt)\n\nnorm_p = os.path.join(u3d_dir, \"app/custom_models/normal_prediction.py\")\nif os.path.exists(norm_p):\n    ntxt = open(norm_p, \"r\", encoding=\"utf-8\").read()\n    ntxt = ntxt.replace(\"ckpt/img2mvimg\", \"ckpt/unet_4ch\").replace(\"ckpt/normal\", \"ckpt/unet_4ch\")\n    open(norm_p, \"w\", encoding=\"utf-8\").write(ntxt)\n\nutils_p = os.path.join(u3d_dir, \"scripts/utils.py\")\nif os.path.exists(utils_p):\n    utxt = open(utils_p, \"r\", encoding=\"utf-8\").read()\nelse:\n    utxt = \"\"\n\nif \"def rotate_normals_torch\" not in utxt:\n    utxt += \"\\n\\ndef rotate_normals_torch(normals, rotation):\\n    return normals\\n\"\n\nif \"session =\" not in utxt:\n    utxt += \"\\nimport rembg\\ntry:\\n    session = rembg.new_session(providers=['CPUExecutionProvider'])\\nexcept Exception:\\n    session = rembg.new_session()\\n\"\n\nopen(utils_p, \"w\", encoding=\"utf-8\").write(utxt)\n\nrecon_path = os.path.join(u3d_dir, \"mesh_reconstruction/recon.py\")\nif os.path.exists(recon_path):\n    code_recon = open(recon_path, \"r\", encoding=\"utf-8\").read()\n    code_recon = code_recon.replace(\"res=512\", \"res=256\").replace(\"resolution=512\", \"resolution=256\")\n    code_recon = code_recon.replace(\"512,\", \"256,\").replace(\"512)\", \"256)\")\n    if \"torch.cuda.empty_cache()\" not in code_recon:\n        code_recon = \"import gc, torch\\n\" + code_recon + \"\\ngc.collect()\\ntorch.cuda.empty_cache()\\n\"\n    open(recon_path, \"w\", encoding=\"utf-8\").write(code_recon)\n\nprint(\"=== [7/9] 2D Stüdyo Sekmesi ve 3D Kayıt Yaması Yazılıyor ===\")\npatch_path = os.path.join(u3d_dir, \"studio_2d_patch.py\")\nstudio_2d_lines = [\n    \"import os, sys, gc, time, random, shutil, torch, rembg, huggingface_hub\",\n    \"huggingface_hub.cached_download = huggingface_hub.hf_hub_download\",\n    \"import gradio as gr\",\n    \"from diffusers import AutoPipelineForText2Image\",\n    \"\",\n    \"def _get_rembg_session():\",\n    \"    from scripts.utils import session as _s\",\n    \"    return _s\",\n    \"\",\n    \"def uret_2d_gorsel(prompt, neg_prompt, steps, cfg, bg_sil):\",\n    \"    if not prompt or not prompt.strip():\",\n    \"        return None, '⚠️ Lütfen İngilizce nesne tarifi yazın (Örn: a red sports car, front view)'\",\n    \"    try:\",\n    \"        gc.collect()\",\n    \"        torch.cuda.empty_cache()\",\n    \"        Moved = []\",\n    \"        for m_adi in ['app.custom_models.mvimg_prediction', 'app.custom_models.normal_prediction']:\",\n    \"            mod = sys.modules.get(m_adi)\",\n    \"            if mod and hasattr(mod, 'pipeline') and hasattr(mod.pipeline, 'unet'):\",\n    \"                try:\",\n    \"                    mod.pipeline.unet.to('cpu')\",\n    \"                    Moved.append(mod.pipeline.unet)\",\n    \"                except Exception: pass\",\n    \"        gc.collect()\",\n    \"        torch.cuda.empty_cache()\",\n    \"        pipe = AutoPipelineForText2Image.from_pretrained(\",\n    \"            'stabilityai/sdxl-turbo', torch_dtype=torch.float16, variant='fp16', low_cpu_mem_usage=True\",\n    \"        ).to('cuda')\",\n    \"        seed = random.randint(1, 99999999)\",\n    \"        gen = torch.Generator(device='cuda').manual_seed(seed)\",\n    \"        with torch.inference_mode():\",\n    \"            img = pipe(\",\n    \"                prompt=prompt + ', isometric, front view, centered, clean background, high detail',\",\n    \"                negative_prompt=neg_prompt,\",\n    \"                num_inference_steps=int(