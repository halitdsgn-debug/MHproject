 = _hf.hf_hub_download\n\nimport torch\n_old_load = torch.load\ndef _safe_load(*args, **kwargs):\n    kwargs['weights_only'] = False\n    return _old_load(*args, **kwargs)\ntorch.load = _safe_load\n\nimport diffusers, importlib, pkgutil\ntry:\n    import custum_3d_diffusion.custum_pipeline as cp_pkg\n    for _, modname, _ in pkgutil.walk_packages(cp_pkg.__path__, cp_pkg.__name__ + \".\"):\n        try:\n            mod = importlib.import_module(modname)\n            for k, v in mod.__dict__.items():\n                if isinstance(v, type):\n                    setattr(diffusers, k, v)\n        except Exception:\n            pass\nexcept Exception as e:\n    pass\n\nif hasattr(diffusers.DiffusionPipeline, 'to'):\n    _old_pipe_to = diffusers.DiffusionPipeline.to\n    def _safe_pipe_to(self, *args, **kwargs):\n        try:\n            return _old_pipe_to(self, *args, **kwargs)\n        except Exception:\n            return self\n    diffusers.DiffusionPipeline.to = _safe_pipe_to\n\nimport transformers\nif hasattr(transformers, 'CLIPVisionModelWithProjection'):\n    _old_clip_from_pretrained = transformers.CLIPVisionModelWithProjection.from_pretrained\n    def _safe_clip_from_pretrained(pretrained_model_name_or_path, *args, **kwargs):\n        try:\n            return _old_clip_from_pretrained(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            kw = dict(kwargs)\n            kw.pop(\"subfolder\", None)\n            return _old_clip_from_pretrained(\"openai/clip-vit-large-patch14\", *args, **kw)\n    transformers.CLIPVisionModelWithProjection.from_pretrained = _safe_clip_from_pretrained\n\nif hasattr(transformers, 'CLIPImageProcessor'):\n    _old_feat_from_pretrained = transformers.CLIPImageProcessor.from_pretrained\n    def _safe_feat_from_pretrained(pretrained_model_name_or_path, *args, **kwargs):\n        try:\n            return _old_feat_from_pretrained(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            kw = dict(kwargs)\n            kw.pop(\"subfolder\", None)\n            return _old_feat_from_pretrained(\"openai/clip-vit-large-patch14\", *args, **kw)\n    transformers.CLIPImageProcessor.from_pretrained = _safe_feat_from_pretrained\n\nif hasattr(diffusers, 'AutoencoderKL'):\n    _old_vae_from_pretrained = diffusers.AutoencoderKL.from_pretrained\n    def _safe_vae_from_pretrained(pretrained_model_name_or_path, *args, **kwargs):\n        try:\n            return _old_vae_from_pretrained(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            kw = {k: v for k, v in kwargs.items() if k != \"subfolder\"}\n            return _old_vae_from_pretrained(\"runwayml/stable-diffusion-v1-5\", subfolder=\"vae\", **kw)\n    diffusers.AutoencoderKL.from_pretrained = _safe_vae_from_pretrained\n\"\"\"\n    if \"_safe_pipe_to\" not in gc_code: gc_code = patches + \"\\n\" + gc_code\n    gc_code = re.sub(r\"(\\w+)\\.(?:queue\\(\\)\\.)?launch\\([^)]*\\)\", r\"\\1.queue().launch(share=True, inbrowser=False)\", gc_code)\n    with open(\"gradio_app.py\", \"w\", encoding=\"utf-8\") as f: f.write(gc_code)\n\nprint(\"\\n🚀 5/5: Unique3D Stüdyo Başlatılıyor (Link birazdan ekrana düşecek)...\")\nLOG = os.path.join(WORK_DIR, \"gradio.log\")\nenv = os.environ.copy()\nenv.update({\"PYTHONPATH\": u3d_dir, \"PYTHONUNBUFFERED\": \"1\", \"PYOPENGL_PLATFORM\": \"egl\"})\nopen(LOG, \"w\").close()\nproc = subprocess.Popen([sys.executable, \"-u\", \"gradio_app.py\"], cwd=u3d_dir, env=env, stdout=open(LOG, \"w\"), stderr=subprocess.STDOUT)\n\npublic_url = None\nlast_size = 0\nwhile proc.poll() is None:\n    time.sleep(3)\n    if os.path.exists(LOG):\n        boyut = os.path.getsize(LOG)\n        if boyut > last_size:\n            with open(LOG, errors=\"ignore\") as f:\n                f.seek(last_size)\n                yeni = f.read()\n                last_size = boyut\n                for satir in yeni.strip().split('\\n'):\n                    if satir.strip()