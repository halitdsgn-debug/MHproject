\nprint(\"=== [4/7] 2D Stüdyo Arayüzü Ekleniyor ===\")\npatch_path = \"studio_2d_patch.py\"\nstudio_2d_lines = [\n    \"import os, sys, gc, time, random, shutil, torch, rembg, huggingface_hub\",\n    \"huggingface_hub.cached_download = huggingface_hub.hf_hub_download\",\n    \"import gradio as gr\",\n    \"from diffusers import AutoPipelineForText2Image\",\n    \"def _get_rembg_session():\",\n    \"    from scripts.utils import session as _s\",\n    \"    return _s\",\n    \"def uret_2d_gorsel(prompt, neg_prompt, steps, cfg, bg_sil):\",\n    \"    if not prompt or not prompt.strip(): return None, '⚠️ Lütfen İngilizce nesne tarifi yazın'\",\n    \"    try:\",\n    \"        gc.collect(); torch.cuda.empty_cache()\",\n    \"        Moved = []\",\n    \"        for m_adi in ['app.custom_models.mvimg_prediction', 'app.custom_models.normal_prediction']:\",\n    \"            mod = sys.modules.get(m_adi)\",\n    \"            if mod and hasattr(mod, 'pipeline') and hasattr(mod.pipeline, 'unet'):\",\n    \"                try: mod.pipeline.unet.to('cpu'); Moved.append(mod.pipeline.unet)\",\n    \"                except Exception: pass\",\n    \"        gc.collect(); torch.cuda.empty_cache()\",\n    \"        pipe = AutoPipelineForText2Image.from_pretrained('stabilityai/sdxl-turbo', torch_dtype=torch.float16, variant='fp16', low_cpu_mem_usage=True).to('cuda')\",\n    \"        seed = random.randint(1, 99999999)\",\n    \"        gen = torch.Generator(device='cuda').manual_seed(seed)\",\n    \"        with torch.inference_mode(): img = pipe(prompt=prompt + ', isometric, front view, centered, clean background, high detail', negative_prompt=neg_prompt, num_inference_steps=int(steps), guidance_scale=float(cfg), generator=gen).images[0]\",\n    \"        del pipe, gen; gc.collect(); torch.cuda.empty_cache()\",\n    \"        for u in Moved:\",\n    \"            try: u.to('cuda')\",\n    \"            except Exception: pass\",\n    \"        if bg_sil: img = rembg.remove(img, session=_get_rembg_session())\",\n    f\"        kayit_yolu = f'{WORK_DIR}/uretilen_2d_gorseller/gorsel_{{int(time.time())}}_{{seed}}.png'\",\n    \"        img.save(kayit_yolu)\",\n    \"        return img, f'✅ Başarılı -> {kayit_yolu}'\",\n    \"    except Exception as e: return None, f'❌ Hata: {str(e)}'\",\n    \"def sadece_arkaplan_sil(img):\",\n    \"    if img is None: return None, '⚠️ Görsel yüklenmedi'\",\n    \"    try:\",\n    \"        out = rembg.remove(img, session=_get_rembg_session())\",\n    f\"        kayit_yolu = f'{WORK_DIR}/uretilen_2d_gorseller/temiz_{{int(time.time())}}.png'\",\n    \"        out.save(kayit_yolu)\",\n    \"        return out, f'✅ Arka plan silindi -> {kayit_yolu}'\",\n    \"    except Exception as e: return None, f'❌ Hata: {str(e)}'\",\n    \"def create_2d_tab():\",\n    \"    with gr.Tab('🎨 2D Görsel Üret & Hazırla'):\",\n    \"        gr.Markdown('### 1. Metinden 3D Uyumlu 2D Nesne Üret veya Arka Planını Sil')\",\n    \"        with gr.Row():\",\n    \"            with gr.Column():\",\n    \"                prompt_in = gr.Textbox(label='2D Nesne Tarifi', placeholder='Örn: a wooden medieval shield')\",\n    \"                neg_in = gr.Textbox(label='Negatif Prompt', value='blurry, cropped, low quality')\",\n    \"                with gr.Row(): steps_in = gr.Slider(1, 8, value=4, step=1, label='Adım'); cfg_in = gr.Slider(0.0, 3.0, value=0.0, step=0.5, label='CFG')\",\n    \"                bg_chk = gr.Checkbox(value=True, label='Otomatik Arka Plan Sil'); btn_uret = gr.Button('🎨 2D Görsel Üret', variant='primary')\",\n    \"                gr.Markdown('---'); yukle_in = gr.Image(type='pil', label='Kendi Fotoğrafını Yükle'); btn_sil = gr.Button('✂️ Sadece Arka Planı Sil')\",\n    \"            with gr.Column():\",\n    \"                out_img = gr.Image(type='pil', label='Hazırlanan Görsel'); out_path = gr.Textbox(label='Kayıt Yolu', interactive=False)\",\n    \"        btn_uret.click(uret_2d_gorsel, inputs=[prompt_in, neg_in, steps_in, cfg_in, bg_chk], outputs=[out_img, out_path])\",\n    \"        btn_sil.click(sadece_arkaplan_sil, inputs=[yukle_in], outputs=[out_img, out_path])\"\n]\nopen(patch_path, \"w\", encoding=\"utf-8\").write(\"\\n\".join(studio_2d_lines) + \"\\n\")\n\nacode = open(app_path, \"r\", encoding=\"utf-8\").read()\nif \"huggingface_hub.cached_download\" not in acode: acode = \"import huggingface_hub\\nhuggingface_hub.cached_download = huggingface_hub.hf_hub_download\\n\" + acode\nif \"studio_2d_patch\" not in acode: acode = acode.replace(\"create_3d_ui()\", \"from studio_2d_patch import create_2d_tab\\n    create_2d_tab()\\n    create_3d_ui()\")\nacode = re.sub(r\"demo(?:\\.queue\\(\\))*\\.launch\\([^\\)]*\\)\", \"demo.queue().launch(share=True, server_name='0.0.0.0', server_port=7860)\", acode)\nopen(app_path, \"w\", encoding=\"utf-8\").write(acode)\n\nprint(\"=== [5/7] Modeller İndiriliyor (Eksik Varsa) ===\")\nfrom huggingface_hub import snapshot_download\nsnapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\nprint(\"=== [6/7] Tünel Başlatılıyor ===\")\ncf_bin = f\"{WORK_DIR}/cloudflared\"\nif not os.path.exists(cf_bin):\n    subprocess.run([\"wget\", \"-q\", \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\", \"-O\", cf_bin], check=True)\n    subprocess.run([\"chmod\", \"+x\", cf_bin], check=True)\n\ncf_log_path = f\"{WORK_DIR}/cf.log\"\nsubprocess.Popen([cf_bin, \"tunnel\", \"--url\", \"http://127.0.0.1:7860\"], stdout=open(cf_log_path, \"w\"), stderr=subprocess.STDOUT)\ntime.sleep(3)\n\nprint(\"=== [7/7] Sunucu Başlatılıyor (Temiz ve Kusursuz) ===\")\nenv_vars = os.environ.copy()\nenv_vars[\"PYTHONPATH\"] = u3d_dir\nenv_vars[\"PYTHONUNBUFFERED\"] = \"1\"\nenv_vars[\"PYOPENGL_PLATFORM\"] = \"egl\"\nenv_vars[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n\ngradio_log_path = f\"{WORK_DIR}/gradio.log\"\nproc = subproces