t, init_type=init_type)\\n\"\n        \"    try:\\n\"\n        \"        import time as _t\\n\"\n        \"        _cikti = f'/kaggle/working/uretilen_3d_modeller/model_{int(_t.time())}.glb'\\n\"\n        \"        new_meshes.export(_cikti)\\n\"\n        \"        print(f'\\\\n✅ 3D MODEL DISKE YEDEKLENDI: {_cikti}\\\\n')\\n\"\n        \"    except Exception as _e:\\n\"\n        \"        print('Yedekleme uyarisi:', _e)\"\n    )\n    g3d = g3d.replace(\n        \"    new_meshes = geo_reconstruct(rgb_pils, None, front_pil, do_refine=do_refine, predict_normal=True, expansion_weight=expansion_weight, init_type=init_type)\",\n        kayit_kodu\n    )\n    open(\"app/gradio_3dgen.py\", \"w\", encoding=\"utf-8\").write(g3d)\n\nfor h in [\"gradio_app.py\", \"app/gradio_3dgen.py\"]:\n    if os.path.exists(h):\n        kh = open(h, \"r\").read().replace(\"show_share_button=True, \", \"\").replace(\", show_share_button=True\", \"\")\n        if \"share=True\" not in kh: kh = kh.replace(\".launch(\", \".launch(share=True, \")\n        kh = re.sub(\n            r\"demo\\.launch\\([^\\)]*\\)\",\n            \"demo.queue().launch(share=True, server_name='0.0.0.0', server_port=7860, max_threads=40)\",\n            kh\n        )\n        kh = \"import oom_patch, huggingface_hub\\nhuggingface_hub.cached_download = huggingface_hub.hf_hub_download\\n\" + kh\n        open(h, \"w\").write(kh)\n\nprint(\"8. Cloudflare Tunnel kuruluyor...\", flush=True)\nif not os.path.exists(\"/kaggle/working/cloudflared\"):\n    subprocess.run([\"wget\", \"-q\", \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\", \"-O\", \"/kaggle/working/cloudflared\"], check=True)\n    subprocess.run([\"chmod\", \"+x\", \"/kaggle/working/cloudflared\"], check=True)\n\nsubprocess.run([\"pkill\", \"-x\", \"cloudflared\"], check=False)\ncf_log = open(\"/kaggle/working/cf.log\", \"w\")\nsubprocess.Popen([\"/kaggle/working/cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:7860\"], stdout=cf_log, stderr=cf_log)\ntime.sleep(5)\ncf_icerik = open(\"/kaggle/working/cf.log\", \"r\").read()\nlinkler = re.findall(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", cf_icerik)\nif linkler:\n    print(\"\\n\" + \"=\"*65)\n    print(f\"🌐 KOPMAYAN CLOUDFLARE LINKIN (BUNA TIKLA): {linkler[0]}\")\n    print(\"=\"*65 + \"\\n\")\n\nprint(\"🚀 9. STUDYO BASLATILIYOR...\", flush=True)\nsubprocess.run([sys.executable, \"gradio_app.py\"], env={**os.environ, \"PYTORCH_CUDA_ALLOC_CONF\": \"expandable_segments:True,max_split_size_mb:128\"}, check=True)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, sys, re, time, json, shutil, subprocess\n\nWORK_DIR = \"/kaggle/working\"\nos.chdir(WORK_DIR)\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True,max_split_size_mb:128\"\nos.makedirs(\"/kaggle/working/uretilen_3d_modeller\", exist_ok=True)\n\nprint(\"1. Unique3D Projesi Hazirlaniyor...\", flush=True)\nif not os.path.exists(\"/kaggle/working/Unique3D\"):\n    subprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\"], check=True)\nos.chdir(\"/kaggle/working/Unique3D\")\n\ntry:\n    import nvdiffrast, pytorch3d\n    print(\"2-3-4. PyTorch ve C++ 3D Motorlari zaten kurulu, derleme atlaniyor...\", flush=True)\nexcept ImportError:\n    print(\"2. Orijinal GPU PyTorch (CUDA 12.4) Kuruluyor...\")\n    os.system(\"pip uninstall -y xformers torch torchvision torchaudio pytorch3d nvdiffrast\")\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"torch\", \"torchvision\", \"torchaudio\", \"--index-url\", \"https://download.pytorch.org/whl/cu124\"])\n\n    print(\"3. Gerekli Kutuphaneler Yukleniyor...\")\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"ninja\", \"torch-scatter\", \"setuptools\", \"wheel\", \"fire\", \"rembg\", \"onnxruntime\", \"trimesh\", \"pymeshlab\", \"einops\", \"omegaconf\", \"transformers==4.38.2\", \"diffusers==0.27.2\", \"peft==0.10.0\", \"accelerate\", \"pydantic==2.8.2\", \"jaxtyping\", \"typeguard\", \"huggingface_hub\"])\n\n    print(\"4. C++ 3D Motorlari (Nvdiffrast ve PyTorch3D) Derleniyor...\")\n    shutil.rmtree(\"nvdiffrast\", ignore_errors=True)\n    shutil.rmtree(\"nvdiffrast_repo\", ignore_errors=True)\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--no-build-isolation\", \"git+https://github.com/NVlabs/nvdiffrast.git\"])\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--no-build-isolation\", \"git+https://github.com/facebookresearch/pytorch3d.git\"])\n\nprint(\"5. Model Agirliklari Indiriliyor...\", flush=True)\nfrom huggingface_hub import snapshot_download\nif not (os.path.exists(\"ckpt/img2mvimg/unet/diffusion_pytorch_model.bin\") or os.path.exists(\"ckpt/img2mvimg/unet/diffusion_pytorch_model.safetensors\")):\n    shutil.rmtree(\"ckpt/img2mvimg\", ignore_errors=True)\n    snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\nprint(\"6. 4 Kanalli U-Net (unet_4ch) Mimarisi Kuruluyor...\", flush=True)\nimg2mvimg_yolu = \"/kaggle/working/Unique3D/ckpt/img2mvimg\"\nunet_4ch_yolu = \"/kaggle/working/Unique3D/ckpt/unet_4ch\"\nshutil.rmtree(unet_4ch_yolu, ignore_errors=True)\nos.makedirs(unet_4ch_yolu + \"/unet\", exist_ok=True)\n\nana_cfg_path = img2mvimg_yolu + \"/unet/config.json\"\nif os.path.exists(ana_cfg_path):\n    ana_cfg = json.loads(open(ana_cfg_path, \"r\").read())\n    ana_cfg[\"in_channels\"] = 4\n    ana_cfg.pop(\"num_class_embeds\", None)\n    ana_cfg[\"addition_embed_type\"] = None\n    open(unet_4ch_yolu + \"/unet/config.json\", \"w\").write(json.dumps(ana_cfg, indent=2))\n\nfor d in os.listdir(img2mvimg_yolu):\n    if d != \"unet\" and not os.path.exists(unet_4ch_yolu + \"/\" + d):\n        os.symlink(img2mvimg_yolu + \"/\" + d, unet_4ch_yolu + \"/\" + d)\n\nfor d in os.listdir(img2mvimg_yolu + \"/unet\"):\n    if d != \"config.json\" and not os.path.exists(unet_4ch_yolu + \"/unet/\" + d):\n        os.symlink(img2mvimg_yolu + \"/unet/\" + d, unet_4ch_yolu + \"/unet/\" + d)\n\nprint(\"7. Kod agaci duzenleniyor...\", flush=True)\n# Once Git tarafini temizle; klasorleri onceden silmek gereksiz ve hata ayiklamayi zorlastiriyor.\nsubprocess.run([\"git\", \"reset\", \"--hard\", \"HEAD\"], check=True)\nsubprocess.run([\"git\", \"clean\", \"-fd\", \"-e\", \"ckpt\", \"-e\", \"ckpt/*\"], check=True)\n\noom_patch_content = r\"\"\"import os, gc, torch\nimport torch.nn.functional as _F\nos.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True,max_split_size_mb:128'\nif not hasattr(_F, '_orig_sdpa'): _F._orig_sdpa = _F.scaled_dot_product_attention\ndef _sliced_sdpa(query, key, value, attn_mask=None, dropout_p=0.0, is_causal=False, **kwargs):\n    if query.dim() == 4 and query.shape[0]*query.shape[1]*query.shape[2]*key.shape[2] > 2097152 and attn_mask is None:\n        out = torch.empty_like(query)\n        for b in range(query.shape[0]):\n            for h in range(query.shape[1]):\n                for i in range(0, query.shape[2], 1024):\n                    out[b:b+1, h:h+1, i:i+1024] = _F._orig_sdpa(query[b:b+1, h:h+1, i:i+1024], key[b:b+1, h:h+1], value[b:b+1, h:h+1], attn_mask=None, dropout_p=dropout_p, is_causal=is_causal, **kwargs)\n        return out\n    elif query.dim() == 3 and query.shape[0]*query.shape[1]*key.shape[1] > 2097152 and attn_mask is None:\n        out = torch.empty_like(query)\n        for bh in range(query.shape[0]):\n            for i in range(0, query.shape[1], 1024):\n                out[bh:bh+1, i:i+1024] = _F._orig_sdpa(query[bh:bh+1, i:i+1024], key[bh:bh+1], value[bh:bh+1], attn_mask=None, dropout_p=dropout_p, is_causal=is_causal, **kwargs)\n        return out\n    return _F._orig_sdpa(query, key, value, attn_mask=attn_mask, dropout_p=dropout_p, is_causal=is_causal, **kwargs)\n_F.scaled_dot_product_attention = _sliced_sdpa\ntorch.nn.functional.scaled_dot_product_attention = _sliced_sdpa\n\"\"\"\n# OOM yamasini bir metin blogu olarak yaz; ic ice Python string listelerinde yapistirma kaynakli girinti hatasi olusmasin.\ncompile(oom_patch_content, \"oom_patch.py\", \"exec\")\nwith open(\"oom_patch.py\", \"w\", encoding=\"utf-8\") as f:\n    f.write(oom_patch_content + \"\\n\")\n\nprint(\"   Python/YAML/JSON dosyalari filtrelenmis klasor taramasiyla aliniyor...\", flush=True)\n# Git ls-files kullanilmiyor; bazi Kaggle oturumlarinda bu komut bekleyebiliyor.\n# Buyuk agirlik klasorleri ve Git metadata'si os.walk'tan tamamen cikariliyor.\n_uzantilar = (\".py\", \".yaml\", \".yml\", \".json\")\n_atlanan_klasorler = {\".git\", \"ckpt\", \"__pycache__\", \".ipynb_checkpoints\", \".cache\", \"node_modules\"}\n_kod_dosyalari = []\n_taranan_klasor = 0","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport sys\nimport json\nimport shutil\nimport subprocess\n\nprint(\"🟢 1. Kaggle Ortamı Hazırlanıyor...\")\nos.chdir('/kaggle/working')\n\n# Linux 3D Sürücülerini Yükle\nos.system(\"apt-get update -q && apt-get install -y -q libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev\")\n\n# Unique3D Deposunu Çek ve Temizle\nif not os.path.exists(\"Unique3D\"):\n    subprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\"], check=True)\nos.chdir('/kaggle/working/Unique3D')\nos.system(\"git reset --hard HEAD\") # Yamaları sıfırla (tekrar çalıştırmalara karşı emniyet)\n\nprint(\"🟢 2. Paketler ve Kütüphaneler Kuruluyor (Bu kısım birkaç dakika sürecek)...\")\nos.system(\"pip install -q ninja torch-scatter -f https://data.pyg.org/whl/torch-2.5.1+cu124.html\")\nos.system(\"pip install -q fire rembg onnxruntime-gpu trimesh pymeshlab einops omegaconf transformers==4.38.2 diffusers==0.27.2 peft==0.10.0 accelerate pydantic==2.8.2\")\nos.system(\"pip install -q -r requirements.txt\")\n\n# Pytorch3D ve Nvdiffrast (NVIDIA 3D Render Motoru)\ntry: import pytorch3d\nexcept ImportError: os.system('pip install -q \"git+https://github.com/facebookresearch/pytorch3d.git\"')\n\ntry: import nvdiffrast\nexcept ImportError:\n    os.system(\"rm -rf nvdiffrast_repo && git clone https://github.com/NVlabs/nvdiffrast.git nvdiffrast_repo\")\n    os.system(\"pip install -q ./nvdiffrast_repo --no-build-isolation\")\n\nprint(\"🟢 3. Model Ağırlıkları (ckpt) Kontrol Ediliyor...\")\nif not os.path.exists(\"ckpt/img2mvimg\"):\n    os.system(\"huggingface-cli download Wuvin/Unique3D --repo-type space --include 'ckpt/*' --local-dir .\")\n\nprint(\"🟢 4. 4 Kanallı UNet Köprüsü ve Parametre Düzeltmeleri Yapılıyor...\")\nimg2mvimg_yolu = \"/kaggle/working/Unique3D/ckpt/img2mvimg\"\nunet_4ch_yolu = \"/kaggle/working/Unique3D/ckpt/unet_4ch\"\nos.makedirs(os.path.join(unet_4ch_yolu, \"unet\"), exist_ok=True)\n\nif os.path.exists(img2mvimg_yolu):\n    # VAE ve yan bileşenleri bağla\n    for dosya in os.listdir(img2mvimg_yolu):\n        if dosya == \"unet\": continue\n        src, dst = os.path.join(img2mvimg_yolu, dosya), os.path.join(unet_4ch_yolu, dosya)\n        if not os.path.exists(dst):\n            if os.path.isdir(src): shutil.copytree(src, dst)\n            else: shutil.copy(src, dst)\n\n    # UNet ağırlıklarını bağla\n    src_unet_dir = os.path.join(img2mvimg_yolu, \"unet\")\n    for dosya in os.listdir(src_unet_dir):\n        if dosya != \"config.json\":\n            src, dst = os.path.join(src_unet_dir, dosya), os.path.join(unet_4ch_yolu, \"unet\", dosya)\n            if not os.path.exists(dst): os.symlink(src, dst)\n\n    # Config dosyasını 4 kanallı yap & class_labels hatasını kökten çöz\n    src_unet_cfg = os.path.join(src_unet_dir, \"config.json\")\n    if os.path.exists(src_unet_cfg):\n        with open(src_unet_cfg, \"r\", encoding=\"utf-8\") as f: cfg = json.load(f)\n        cfg[\"in_channels\"] = 4\n        if \"num_class_embeds\" in cfg: del cfg[\"num_class_embeds\"]\n        if \"addition_embed_type\" in cfg: cfg[\"addition_embed_type\"] = None\n        with open(os.path.join(unet_4ch_yolu, \"unet/config.json\"), \"w\", encoding=\"utf-8\") as f: json.dump(cfg, f, indent=2)\n\n# Harici 404 yollarını yerel dosyalara çevir\nfor kok, _, dosyalar in os.walk(\".\"):\n    for dosya in dosyalar:\n        if dosya.endswith((\".py\", \".yaml\", \".yml\", \".json\")):\n            yol = os.path.join(kok, dosya)\n            try:\n                with open(yol, \"r\", encoding=\"utf-8\") as f: c = f.read()\n                if \"lambdalabs/sd-image-variations-diffusers\" in c:\n                    c = c.replace(\"lambdalabs/sd-image-variations-diffusers\", img2mvimg_yolu)\n                    with open(yol, \"w\", encoding=\"utf-8\") as f: f.write(c)\n                if \"normal\" in dosya.lower() and img2mvimg_yolu in c:\n                    c = c.replace(img2mvimg_yolu, unet_4ch_yolu)\n                    with open(yol, \"w\", encoding=\"utf-8\") as f: f.write(c)\n            except Exception: pass\n\nprint(\"🟢 5. Sistem Uyumsuzluk ve Bellek (OOM) Yamaları Uygulanıyor...\")\n\n# Yama A: sd_model_zoo.py (device_map auto hatası çözümü)\nyol_zoo = \"scripts/sd_model_zoo.py\"\nif os.path.exists(yol_zoo):\n    with open(yol_zoo, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    k = k.replace('device_map=\"auto\"', '').replace(\"device_map='auto'\", \"\")\n    eski_satir = \"pipe = model_cls.from_pretrained(ckpt_or_pretrained, torch_dtype=torch_dtype, **kwargs)\"\n    yeni_satir = \"kwargs.pop('device_map', None); pipe = model_cls.from_pretrained(ckpt_or_pretrained, torch_dtype=torch_dtype, **kwargs)\"\n    with open(yol_zoo, \"w\", encoding=\"utf-8\") as f: f.write(k.replace(eski_satir, yeni_satir))\n\n# Yama B: unifield_processor.py (low_cpu_mem_usage ve tekrarlanan parametre çözümü)\nyol_proc = \"custum_3d_diffusion/custum_modules/unifield_processor.py\"\nif os.path.exists(yol_proc):\n    with open(yol_proc, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    k = k.replace('**unet_kwargs', \"**{k: v for k, v in unet_kwargs.items() if k != 'low_cpu_mem_usage'}, low_cpu_mem_usage=False\")\n    eski_ref = 'torch_dtype=self.unet.dtype'\n    yeni_ref = 'torch_dtype=self.unet.dtype, low_cpu_mem_usage=False, ignore_mismatched_sizes=True'\n    if yeni_ref not in k: k = k.replace(eski_ref, yeni_ref)\n    with open(yol_proc, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama C: utils.py (Meta tensör çökme sorunu CPU köprüsü)\nyol_utils = \"app/custom_models/utils.py\"\nif os.path.exists(yol_utils):\n    with open(yol_utils, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_load = \"configurable_unet.unet.load_state_dict(state_dict, strict=False)\"\n    yeni_load = \"\"\"try: configurable_unet.unet.to_empty(device=\"cpu\")\n    except Exception: pass\n    if 'conv_in.weight' in state_dict:\n        s1, s2 = state_dict['conv_in.weight'].shape, configurable_unet.unet.conv_in.weight.shape\n        if s1 != s2: configurable_unet.unet.conv_in = torch.nn.Conv2d(s1[1], s1[0], kernel_size=3, padding=1, device=torch.device(\"cpu\"), dtype=weight_dtype)\n    if hasattr(configurable_unet.unet, 'ref_unet') and 'ref_unet.conv_in.weight' in state_dict:\n        s1, s2 = state_dict['ref_unet.conv_in.weight'].shape, configurable_unet.unet.ref_unet.conv_in.weight.shape\n        if s1 != s2: configurable_unet.unet.ref_unet.conv_in = torch.nn.Conv2d(s1[1], s1[0], kernel_size=3, padding=1, device=torch.device(\"cpu\"), dtype=weight_dtype)\n    try: configurable_unet.unet.load_state_dict(state_dict, strict=False, assign=True)\n    except Exception: configurable_unet.unet.load_state_dict(state_dict, strict=False)\"\"\"\n    if eski_load in k: k = k.replace(eski_load, yeni_load)\n    \n    eski_to = \"configurable_unet.unet.to(device, dtype=weight_dtype)\"\n    yeni_to = \"\"\"try: configurable_unet.unet.to(device, dtype=weight_dtype)\n    except NotImplementedError:\n        configurable_unet.unet.to_empty(device=device)\n        configurable_unet.unet.to(device, dtype=weight_dtype)\"\"\"\n    if eski_to in k: k = k.replace(eski_to, yeni_to)\n    with open(yol_utils, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama D: OOM (Ekran Kartı Belleği) Temizleyicisi\nyol_multiview = \"scripts/multiview_inference.py\"\nif os.path.exists(yol_multiview):\n    with open(yol_multiview, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_kod = \"rm_normals = predict_normals([img.resize((512, 512), resample=Image.LANCZOS) for img in img_list], guidance_scale=1.5)\"\n    yeni_kod = \"import torch, gc; torch.cuda.empty_cache(); gc.collect(); rm_normals = predict_normals([img.resize((512, 512), resample=Image.LANCZOS) for img in img_list], guidance_scale=1.5)\"\n    if eski_kod in k: k = k.replace(eski_kod, yeni_kod)\n    with open(yol_multiview, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\nyol_app = \"app/gradio_3dgen.py\"\nif os.path.exists(yol_app):\n    with open(yol_app, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    eski_kod = \"def generate3dv2(rgb_pils, front_pil, init_type, do_refine=True, expansion_weight=0.1):\"\n    yeni_kod = \"def generate3dv2(rgb_pils, front_pil, init_type, do_refine=True, expansion_weight=0.1):\\n    import torch, gc\\n    torch.cuda.empty_cache()\\n    gc.collect()\"\n    if eski_kod in k: k = k.replace(eski_kod, yeni_kod)\n    with open(yol_app, \"w\", encoding=\"utf-8\") as f: f.write(k)\n\n# Yama E: rembg CPU modu ve Gradio share linki\nyol_rembg = \"scripts/utils.py\"\nif os.path.exists(yol_rembg):\n    with open(yol_rembg, \"r\", encoding=\"utf-8\") as f: k = f.read()\n    if \"providers=providers\" in k:\n        with open(yol_rembg, \"w\", encoding=\"utf-8\") as f: f.write(k.replace(\"providers=providers\", \"providers=['CPUExecutionProvider']\"))\n\nfor hedef in [\"gradio_app.py\", \"app/gradio_3dgen.py\"]:\n    if os.path.exists(hedef):\n        with open(hedef, \"r\", encoding=\"utf-8\") as f: k = f.read()\n        k = k.replace(\"show_share_button=True, \", \"\").replac