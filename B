t+https://github.com/facebookresearch/pytorch3d.git@stable'\")\n\n# ══════════════════════════════════════════════════════════\n# 4) MODELİ İNDİR (Disk dostu)\n# ══════════════════════════════════════════════════════════\nprint(\"📥 Model ağırlıkları indiriliyor (Gereksiz dosyalar atlanarak)...\")\nos.makedirs(\"ckpt\", exist_ok=True)\n\nfrom huggingface_hub import snapshot_download\ntry:\n    snapshot_download(\n        repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", local_dir=\"ckpt\",\n        ignore_patterns=[\"*.md\", \".git*\", \"*.png\", \"*.jpg\", \"*.gif\", \"*.mp4\", \"*.ipynb\", \"*.zip\"], # ZIP dosyalarını atla\n        max_workers=1 # Aynı anda tek dosya indir, disk şişmesin\n    )\n    print(\"✅ Modeller indirildi.\")\nexcept Exception as e:\n    print(f\"❌ Model indirme hatası: {e}\")\n    print(\"🔄 Alternatif olarak ckpt.zip indirilip çıkarılıyor...\")\n    os.system(\"wget -q https://huggingface.co/spaces/Wuvin/Unique3D/resolve/main/ckpt.zip -O ckpt.zip\")\n    if os.path.exists(\"ckpt.zip\") and os.path.getsize(\"ckpt.zip\") > 1000000:\n        import zipfile\n        with zipfile.ZipFile(\"ckpt.zip\", 'r') as zip_ref:\n            zip_ref.extractall(\".\")\n        os.remove(\"ckpt.zip\")\n        print(\"✅ ckpt.zip indirildi ve çıkarıldı.\")\n\n# İndirme sonrası tekrar temizlik\nos.system(\"rm -rf /tmp/* >/dev/null 2>&1\")\n\n# ══════════════════════════════════════════════════════════\n# 5) YAMALAR (Önce sıfırla, sonra tek seferlik yama yap)\n# ══════════════════════════════════════════════════════════\nprint(\"⚙️ Yamalar uygulanıyor...\")\n\nos.system(\"git checkout custum_3d_diffusion/custum_modules/unifield_processor.py\")\nos.system(\"git checkout custum_3d_diffusion/custum_modules/attention_processors.py\")\nos.system(\"git checkout app/custom_models/utils.py\")\nos.system(\"git checkout app/gradio_3dgen.py\")\nos.system(\"git checkout scripts/multiview_inference.py\")\ntime.sleep(1)\n\n# Kanallar\nfor cfg_path, channels in [(\"ckpt/img2mv