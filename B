ue3D\"\nos.chdir(u3d_dir)\n\nprint(\"🔧 1. Alt klasör (subfolder) hatası çözülüyor (Dosyalar otomatik kopyalanıyor)...\")\n# Dosyaları üst klasöre bağlayarak (symlink) yolu bulamama sorununu kökten çözüyoruz\nfor d_name in [\"ckpt/img2mvimg\", \"ckpt/unet_4ch\", \"ckpt/normal\"]:\n    d_path = os.path.join(u3d_dir, d_name)\n    unet_path = os.path.join(d_path, \"unet\")\n    if os.path.exists(unet_path):\n        for f in os.listdir(unet_path):\n            src = os.path.join(unet_path, f)\n            dst = os.path.join(d_path, f)\n            if not os.path.exists(dst):\n                try: os.symlink(os.path.abspath(src), dst)\n                except: pass\n\n# Uygulamadaki yamayı daha güçlü bir versiyonla güncelliyoruz\napp_path = \"gradio_app.py\"\nif os.path.exists(app_path):\n    acode = open(app_path, \"r\", encoding=\"utf-8\").read()\n    \n    yeni_yama = \"\"\"\nimport torch\n_old_load = torch.load\ntorch.load = lambda *a, **k: _old_load(*a, **{**k, 'weights_only': False})\n\nfrom diffusers import UNet2DConditionModel, AutoencoderKL\nfrom transformers import CLIPVisionModelWithProjection\nimport functools\nimport os\n\ndef patch_from_pretrained(cls, subf):\n    old_fn = cls.from_pretrained\n    @classmethod\n    @functools.wraps(old_fn)\n    def new_fn(c, pretrained_model_name_or_path, *args, **kwargs):\n        if \"subfolder\" not in kwargs or kwargs[\"subfolder\"] is None:\n            kwargs[\"subfolder\"] = subf\n        try:\n            return old_fn(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            if \"subfolder\" in kwargs: del kwargs[\"subfolder\"]\n            return old_fn(pretrained_model_name_or_path, *args, **kwargs)\n            \n    cls.from_pretrained = new_fn\n\npatch_from_pretrained(UNet2DConditionModel, \"unet\")\npatch_from_pretrained(AutoencoderKL, \"vae\")\npatch_from_pretrained(CLIPVisionModelWithProjection, \"image_encoder\")\n\"\"\"\n    # Eski yamayı temizle ve yenisini ekle\n    acode = 