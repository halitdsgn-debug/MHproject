   if not os.path.exists(dst):\n                try: os.symlink(os.path.abspath(src), dst)\n                except: pass\n\n# Uygulamadaki yamayı daha güçlü bir versiyonla güncelliyoruz\napp_path = \"gradio_app.py\"\nif os.path.exists(app_path):\n    acode = open(app_path, \"r\", encoding=\"utf-8\").read()\n    \n    yeni_yama = \"\"\"\nimport torch\n_old_load = torch.load\ntorch.load = lambda *a, **k: _old_load(*a, **{**k, 'weights_only': False})\n\nfrom diffusers import UNet2DConditionModel, AutoencoderKL\nfrom transformers import CLIPVisionModelWithProjection\nimport functools\nimport os\n\ndef patch_from_pretrained(cls, subf):\n    old_fn = cls.from_pretrained\n    @classmethod\n    @functools.wraps(old_fn)\n    def new_fn(c, pretrained_model_name_or_path, *args, **kwargs):\n        if \"subfolder\" not in kwargs or kwargs[\"subfolder\"] is None:\n            kwargs[\"subfolder\"] = subf\n        try:\n            return old_fn(pretrained_model_name_or_path, *args, **kwargs)\n        except Exception:\n            if \"subfolder\" in kwargs: del kwargs[\"subfolder\"]\n            return old_fn(pretrained_model_name_or_path, *args, **kwargs)\n            \n    cls.from_pretrained = new_fn\n\npatch_from_pretrained(UNet2DConditionModel, \"unet\")\npatch_from_pretrained(AutoencoderKL, \"vae\")\npatch_from_pretrained(CLIPVisionModelWithProjection, \"image_encoder\")\n\"\"\"\n    # Eski yamayı temizle ve yenisini ekle\n    acode = re.sub(r\"import torch\\n_old_load = torch\\.load.*?patch_from_pretrained\\(CLIPVisionModelWithProjection, \\\"image_encoder\\\"\\)\\n\", \"\", acode, flags=re.DOTALL)\n    acode = yeni_yama + \"\\n\" + acode.lstrip()\n    open(app_path, \"w\", encoding=\"utf-8\").write(acode)\n\nprint(\"📦 2. Eksik '.safetensors' okuyucu kütüphanesi kuruluyor...\")\nsubprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"safetensors\"])\n\nprint(\"🧹 3. Takılı kalan eski işlemler temizleniyor...\")\nos.system(\"fuser -k 7860/tcp >/dev/null 2>&1\")\nos.system(\"pkill -9 -f gradio_app.py >/dev/null 2>&1\")\n\nprint(\"🚀 4. Sunucu başlatılıyor (Bu kez hiçbir engel kalmadı!)...\")\nenv_vars = os.environ.copy()\nenv_vars[\"PYTHONPATH\"] = u3d_dir\nenv_vars[\"PYTHONUNBUFFERED\"] = \"1\"\nenv_vars[\"PYOPENGL_PLATFORM\"] = \"egl\"\n\ngradio_log_path = f\"{WORK_DIR}/gradio.log\"\ncf_log_path = f\"{WORK_DIR}/cf.log\"\ngradio_log = open(gradio_log_path, \"w\")\n\nproc = subprocess.Popen(\n    [sys.executable, \"-u\", \"gradio_app.py\"],\n    cwd=u3d_dir,\n    env=env_vars,\n    stdout=gradio_log,\n    stderr=subprocess.STDOUT\n)\n\nprint(\"🔍 Loglar izleniyor...\\n\")\nwhile True:\n    if os.path.exists(gradio_log_path):\n        icerik = open(gradio_log_path, \"r\", errors=\"ignore\").read()\n        satirlar = icerik.strip().split('\\n')\n        \n        if len(satirlar) > 0:\n            print(f\"\\r⏳ Son işlem: {satirlar[-1][:120]:<120}\", end=\"\")\n            \n        if \"Running on local URL\" in icerik or \"7860\" in icerik:\n            print(\"\\n\\n✅ SUNUCU BAŞARIYLA BAŞLATILDI!\")\n            break\n            \n        if (\"Traceback\" in icerik or \"SyntaxError\" in icerik or \"TypeError\" in icerik or \"ImportError\" in icerik or \"RuntimeError\" in icerik or \"OSError\" in icerik) and \"FutureWarning\" not in satirlar[-1]:\n            print(\"\\n\\n❌ BİR HATA OLUŞTU! Hata detayı:\")\n            print('\\n'.join(satirlar[-15:]))\n            break\n            \n    time.sleep(3)\n\nif proc.poll() is None:\n    time.sleep(3)\n    cf_icerik = open(cf_log_path, \"r\", errors=\"ignore\").read() if os.path.exists(cf_log_path) else \"\"\n    gr_icerik = open(gradio_log_path, \"r\", errors=\"ignore\").read()\n    \n    cf_linkler = re.findall(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", cf_icerik)\n    gr_linkler = re.findall(r\"https://[a-zA-Z0-9]+\\.gradio\\.live\", gr_icerik)\n\n    print(\"\\n\" + \"=\"*70)\n    print(\"🚀 UNIQUE3D STÜDYO TAMAMEN HAZIR!\")\n    if cf_linkler: print(f\"🌐 1. CLOUDFLARE LİNKİNİZ : {cf_linkler[-1]}\")\n    if gr_linkler: print(f\"🌐 2. GRADIO LIVE LİNKİNİZ : {gr_linkler[-1]}\")\n    print(\"=\"*70 + \"\\n\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, sys, shutil, subprocess, time, json\n\nWORK_DIR = \"/kaggle/working\" if os.path.exists(\"/kaggle/working\") else \"/content\"\nu3d_dir = f\"{WORK_DIR}/Unique3D\"\nos.chdir(WORK_DIR)\n\nprint(\"=== [1/7] Hatalı Dosyalar Temizleniyor ve Kütüphaneler Sabitleniyor ===\")\nos.system(\"fuser -k 7860/tcp >/dev/null 2>&1\")\nos.system(\"pkill -9 -f gradio_app.py >/dev/null 2>&1\")\n\n# Uyumsuzluk çıkaran her şeyi sabit sürümlerle eziyoruz\nsubprocess.check_call([\n    sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \n    \"diffusers==0.27.2\", \"transformers==4.39.3\", \"peft==0.10.0\", \n    \"accelerate==0.28.0\", \"safetensors\", \"rembg\", \"onnxruntime\", \n    \"gradio\", \"pymeshlab\"\n])\n\nprint(\"=== [2/7] Proje ve Modeller Yeniden Hazırlanıyor ===\")\nif os.path.exists(u3d_dir):\n    # İndirilen 2GB'lık modelleri silinmesin diye korumaya alıyoruz\n    if os.path.exists(f\"{u3d_dir}/ckpt\"):\n        os.system(f\"mv {u3d_dir}/ckpt {WORK_DIR}/ckpt_backup\")\n    os.system(f\"rm -rf {u3d_dir}\")\n\nsubprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\", u3d_dir], check=True)\n\nif os.path.exists(f\"{WORK_DIR}/ckpt_backup\"):\n    os.system(f\"mv {WORK_DIR}/ckpt_backup {u3d_dir}/ckpt\")\n\nos.chdir(u3d_dir)\n\nfrom huggingface_hub import snapshot_download\n# Wuvin modellerini kontrol et\nif not os.path.exists(\"ckpt/img2mvimg/unet/config.json\"):\n    snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\n# İŞTE ÇÖZÜM: Hata veren lambdalabs modelini KENDİ özel klasörüne indiriyoruz\nlambda_dir = f\"{u3d_dir}/lambdalabs_local\"\nif not os.path.exists(lambda_dir):\n    print(\"⏳ Lambdalabs temel modeli yerel diske indiriliyor (1-2 dakika)...\")\n    snapshot_download(\"lambdalabs/sd-image-variations-diffusers\", local_dir=lambda_dir)\n\nprint(\"=== [3/7] 4 Kanallı UNet Mimarisi Kuruluyor ===\")\nimg2mvimg_yolu = f\"{u3d_dir}/ckpt/img2mvimg\"\nunet_4ch_yolu = f\"{u3d_dir}/ckpt/unet_4ch\"\nif os.path.exists(img2mvimg_yolu):\n    os.system(f\"rm -rf {unet_4ch_yolu}\")\n    os.makedirs(unet_4ch_yolu + \"/unet\", exist_ok=True)\n    ana_cfg = json.loads(open(img2mvimg_yolu + \"/unet/config.json\", \"r\").read())\n    ana_cfg[\"in_channels\"] = 4\n    ana_cfg.pop(\"num_class_embeds\", None)\n    ana_cfg[\"addition_embed_type\"] = None\n    open(unet_4ch_yolu + \"/unet/config.json\", \"w\").write(json.dumps(ana_cfg, indent=2))\n    \n    # Symlink işlemleri\n    for d in os.listdir(img2mvimg_yolu):\n        if d != \"unet\": os.symlink(os.path.join(img2mvimg_yolu, d), os.path.join(unet_4ch_yolu, d))\n    for d in os.listdir(img2mvimg_yolu + \"/unet\"):\n        if d != \"config.json\": os.symlink(os.path.join(img2mvimg_yolu, \"unet\", d), os.path.join(unet_4ch_yolu, \"unet\", d))\n\nprint(\"=== [4/7] Hata Çözen Yamalar (PyTorch, Rembg, Model Yolları) Uygulanıyor ===\")\nfor root, _, files in os.walk(u3d_dir):\n    for file in files:\n        if file.endswith((\".py\", \".yaml\")):\n            path = os.path.join(root, file)\n            with open(path, \"r\", encoding=\"utf-8\") as f:\n                txt = f.read()\n            # Bozuk internet reposunu, indirdiğimiz DOĞRU yerel klasörle değiştiriyoruz\n            ntxt = txt.replace(\"lambdalabs/sd-image-variations-diffusers\", lambda_dir)\n            ntxt = ntxt.replace(\"RasterizeGLContext\", \"RasterizeCudaContext\")\n            ntxt = ntxt.replace(\"pymeshlab.PercentageValue\", \"pymeshlab.PureValue\").replace(\"pymeshlab.Percentage\", \"pymeshlab.PureValue\")\n            if txt != ntxt:\n                with open(path, \"w\", encoding=\"utf-8\") as f:\n                    f.write(ntxt)\n\n# PyTorch güvenlik yamasını ekliyoruz\napp_path = \"gradio_app.py\"\nacode = open(app_path, \"r\", encoding=\"utf-8\").read()\nacode = \"import torch\\n_old_load = torch.load\\ntorch.load = lambda *a, **k: _old_load(*a, **{**k, 'weights_only': False})\\n\" + acode\n\n# 2D Stüdyo Sekmesi Ekleniyor\npatch_path = \"studio_2d_patch.py\"\nstudio_2d_lines = [\n    \"import gc, time, random, torch, rembg\",\n    \"import gradio as gr\",\n    \"from diffusers import AutoPipelineForText2Image\",\n    \"def _get_rembg_session():\",\n    \"    from scripts.utils import session as _s\",\n    \"    return _s\",\n    \"def uret_2d_gorsel(prompt, neg_prompt, steps, cfg, bg_sil):\",\n    \"    if not prompt: return None, '⚠️ Lütfen nesne tarifi yazın'\",\n    \"    try:\",\n    \"        gc.collect(); torch.cuda.empty_cache()\",\n    \"        pipe = AutoPipelineForText2Image.from_pretrained('stabilityai/sdxl-turbo', torch_dtype=torch.float16, variant='fp16', low_cpu_mem_usage=True).to('cuda')\",\n    \"        gen = torch.Generator(device='cuda').manual_seed(random.randint(1, 99999999))\",\n    \"        with torch.inference_mode(): img = pipe(prompt=prompt+', isometric, front view, centered, clean background, high detail', negative_prompt=neg_prompt, num_inference_steps=int(steps), guidance_scale=float(cfg), generator=gen).images[0]\",\n    \"        del pipe, gen; gc.collect(); torch.cuda.empty_cache()\",\n    \"        if bg_sil: img = rembg.remove(img, session=_get_rembg_session())\",\n    \"        return img, '✅ Başarılı'\",\n    \"    except Exception as e: return None, f'❌ Hata: {str(e)}'\",\n    \"def sadece_arkaplan_sil(img):\",\n    \"    if img is None: return None, '⚠️ Görsel yok'\",\n    \"    return rembg.remove(img, session=_get_rembg_session()), '✅ Arka plan silindi'\",\n    \"def create_2d_tab():\",\n    \"    with gr.Tab('🎨 2D Görsel Üret & Hazırla'):\",\n    \"        with gr.Row():\",\n    \"            with gr.Column():\",\n    \"                prompt_in = gr.Textb