live\", icerik)\n            if m:\n                public_url = m.group(0)\n                print(\"\\n\" + \"=\"*70)\n                print(f\"🌐 LİNKİNİZ HAZIR: {public_url}\")\n                print(\"=\"*70 + \"\\n\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"if os.path.exists(\"/kaggle/working/Unique3D/ckpt\"):\n    os.system(\"mv /kaggle/working/Unique3D/ckpt /kaggle/working/ckpt_backup\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os, sys, shutil, subprocess, time, re, json, gc\n\n# 1. ÇALIŞMA ALANI HAZIRLIĞI\nWORK_DIR = \"/kaggle/working\" if os.path.exists(\"/kaggle/working\") else \"/content\"\nu3d_dir = f\"{WORK_DIR}/Unique3D\"\nckpt_backup = f\"{WORK_DIR}/ckpt_backup\"\nos.chdir(WORK_DIR)\n\nos.environ[\"TORCH_CUDA_ARCH_LIST\"] = \"7.5;8.0;8.6\"\nos.environ[\"FORCE_CUDA\"] = \"1\"\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\nos.environ[\"PYOPENGL_PLATFORM\"] = \"egl\"\n\nprint(\"=== [1/8] Eski Süreçler Temizleniyor ===\")\nos.system(\"fuser -k 7860/tcp >/dev/null 2>&1\")\nos.system(\"pkill -9 -f gradio_app.py >/dev/null 2>&1\")\nos.system(\"pkill -9 -f cloudflared >/dev/null 2>&1\")\ngc.collect()\n\nos.makedirs(f\"{WORK_DIR}/uretilen_3d_modeller\", exist_ok=True)\nos.makedirs(f\"{WORK_DIR}/uretilen_2d_gorseller\", exist_ok=True)\n\nprint(\"=== [2/8] Linux Sistem Paketleri Kuruluyor ===\")\nos.system(\"apt-get update -qq && apt-get install -y -qq libgl1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev libglib2.0-0 build-essential ninja-build psmisc git wget >/dev/null 2>&1\")\nsubprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--upgrade\", \"pip\", \"ninja\", \"setuptools\", \"wheel\"])\n\nprint(\"=== [3/8] Unique3D ve UYUMLU Kütüphaneler Kuruluyor (ÖNEMLİ) ===\")\n# Modelleri yedekle\nif os.path.exists(f\"{u3d_dir}/ckpt\"):\n    if os.path.exists(ckpt_backup): os.system(f\"rm -rf {ckpt_backup}\")\n    shutil.move(f\"{u3d_dir}/ckpt\", ckpt_backup)\n\n# KİLİTLENEN KLASÖRÜ ZORLA SİL VE YENİDEN İNDİR\nos.system(f\"rm -rf {u3d_dir}\")\nsubprocess.run([\"git\", \"clone\", \"https://github.com/AiuniAI/Unique3D.git\", u3d_dir], check=True)\n\n# Modelleri geri taşı\nif os.path.exists(ckpt_backup):\n    shutil.move(ckpt_backup, f\"{u3d_dir}/ckpt\")\n\n# Bağımlılık cehennemini çözen %100 uyumlu spesifik sürümler burada kuruluyor:\nsubprocess.check_call([\n    sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n    \"fire\", \"rembg\", \"onnxruntime\", \"trimesh\", \"einops\", \"omegaconf\",\n    \"huggingface_hub\", \"gradio\", \"gradio-client\", \"pydantic\", \"jaxtyping\", \"typeguard\",\n    \"imageio\", \"scikit-image\", \"opencv-python-headless\", \"matplotlib\", \"plyfile\", \"pymeshlab\",\n    \"diffusers==0.27.2\", \"transformers==4.39.3\", \"peft==0.10.0\", \"accelerate==0.28.0\"\n])\n\nimport torch\nif torch.cuda.is_available(): torch.cuda.empty_cache()\n\nprint(\"=== [4/8] nvdiffrast ve PyTorch3D Derleniyor ===\")\ntry:\n    import nvdiffrast\nexcept ImportError:\n    os.chdir(WORK_DIR)\n    os.system(\"rm -rf nvdiffrast\")\n    subprocess.run([\"git\", \"clone\", \"https://github.com/NVlabs/nvdiffrast.git\"], check=True)\n    os.chdir(\"nvdiffrast\")\n    res = subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--no-build-isolation\", \".\"], capture_output=True, text=True)\n    if res.returncode != 0:\n        site_pkg = [p for p in sys.path if \"dist-packages\" in p or \"site-packages\" in p][0]\n        shutil.copytree(\"nvdiffrast\", os.path.join(site_pkg, \"nvdiffrast\"), dirs_exist_ok=True)\n    os.chdir(WORK_DIR)\n\ntry:\n    import pytorch3d\nexcept ImportError:\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--no-build-isolation\", \"git+https://github.com/facebookresearch/pytorch3d.git\"])\n\nos.chdir(u3d_dir)\n\nprint(\"=== [5/8] Model Ağırlıkları İndiriliyor ===\")\nfrom huggingface_hub import snapshot_download\nif not os.path.exists(\"ckpt/img2mvimg/unet/config.json\"):\n    snapshot_download(repo_id=\"Wuvin/Unique3D\", repo_type=\"space\", allow_patterns=[\"ckpt/*\"], local_dir=\".\", local_dir_use_symlinks=False)\n\nimg2mvimg_yolu = f\"{u3d_dir}/ckpt/img2mvimg\"\nunet_4ch_yolu = f\"{u3d_dir}/ckpt/unet_4ch\"\nif os.path.exists(img2mvimg_yolu):\n    os.system(f\"rm -rf {unet_4ch_yolu}\")\n    os.makedirs(unet_4ch_yolu + \"/unet\", exist_ok=True)\n    ana_cfg = json.loads(open(img2mvimg_yolu + \"/unet/config.json\", \"r\").read())\n    ana_cfg[\"in_channels\"] = 4\n    ana_cfg.pop(\"num_class_embeds\", None)\n    ana_cfg[\"addition_embed_type\"] = None\n    open(unet_4ch_yolu + \"/unet/config.json\", \"w\").write(json.dumps(ana_cfg, indent=2))\n    for d in os.listdir(img2mvimg_yolu):\n        if d != \"unet\": os.symlink(img2mvimg_yolu + \"/\" + d, unet_4ch_yolu + \"/\" + d)\n    for d in os.listdir(img2mvimg_yolu + \"/unet\"):\n        if d != \"config.json\": os.symlink(img2mvimg_yolu + \"/unet/\" + d, unet_4ch_yolu + \"/unet/\" + d)\n\nprint(\"=== [6/8] PyTorch, Rembg ve Arayüz Yamaları Uygulanıyor ===\")\napp_path = os.path.join(u3d_dir, \"gradio_app.py\")\nif os.path.exists(app_path):\n    acode = open(app_path, \"r\", encoding=\"utf-8\").read()\n    \n    # KUSURSUZ YAMA: weights_only ve lambdalabs sorunları çözülüyor\n    bypass_code = \"\"\"\nimport torch\n_old_load = torch.load\ntorch.load = lambda *a, **k: _old_load(*a, **{**k, 'weights_only': False})\n\nfrom diffusers import UNet2DConditionModel, AutoencoderKL\nfrom transformers import CLIPVisionModelWithProjection\nimport functools\n\ndef patch_from_pretrained(cls, subf):\n    old_fn = cls.from_pretrained\n    @classmethod\n    @functools.wraps(old_fn)\n    def new_fn(c, pretrained_model_name_or_path, *args, **kwargs):\n        if \"lambdalabs/sd-image-variations-diffusers\" in str(pretrained_model_name_or_path) and \"subfolder\" not in kwargs:\n            kwargs[\"subfolder\"] = subf\n        return old_fn(pretrained_model_name_or_path, *args, **kwargs)\n    cls.from_pretrained = new_fn\n\npatch_from_pretrained(UNet2DConditionModel, \"unet\")\npatch_from_pretrained(AutoencoderKL, \"vae\")\npatch_from_pretrained(CLIPVisionModelWithProjection, \"image_encoder\")\n\"\"\"\n    if \"patch_from_pretrained\" not in acode:\n        acode = bypass_code + \"\\n\" + acode\n    open(app_path, \"w\", encoding=\"utf-8\").write(acode)\n\ntry:\n    import gradio_client.utils as client_utils\n    utils_path = client_utils.__file__\n    code_client = open(utils_path, \"r\", encoding=\"utf-8\").read()\n    code_client = code_client.replace(\"def get_type(schema):\", \"def get_type(schema):\\n    if not isinstance(schema, dict): return 'Any'\")\n    code_client = code_client.replace(\"def _json_schema_to_python_type(schema, defs):\", \"def _json_schema_to_python_type(schema, defs):\\n    if not isinstance(schema, dict): return 'Any'\")\n    open(utils_path, \"w\", encoding=\"utf-8\").write(code_client)\nexcept Exception: pass\n\nfor root, _, files in os.walk(u3d_dir):\n    for file in files:\n        if file.endswith(\".py\"):\n            path = os.path.join(root, file)\n            txt = open(path, \"r\", errors=\"ignore\").read()\n            ntxt = txt.replace(\"C:\\\\\\\\Users\\\\\\\\admin\\\\\\\\Desktop\\\\\\\\Unique3D\\\\\\\\\", \"\")\n            ntxt = ntxt.replace(\"RasterizeGLContext\", \"RasterizeCudaContext\")\n            ntxt = ntxt.replace(\"output_db=False,\", \"\").replace(\", output_db=False\", \"\").replace(\"output_db=False\", \"\")\n            ntxt = ntxt.replace(\"pymeshlab.PercentageValue\", \"pymeshlab.PureValue\").replace(\"pymeshlab.Percentage\", \"pymeshlab.PureValue\")\n            if txt != ntxt: open(path, \"w\", encoding=\"utf-8\").write(ntxt)\n\nrecon_path = os.path.join(u3d_dir, \"mesh_reconstruction/recon.py\")\nif os.path.exists(recon_path):\n    code_recon = open(recon_path, \"r\", encoding=\"utf-8\").read()\n    code_recon = code_recon.replace(\"res=512\", \"res=256\").replace(\"resolution=512\", \"resolution=256\").replace(\"512,\", \"256,\").replace(\"512)\", \"256)\")\n    if \"torch.cuda.empty_cache()\" not in code_recon: code_recon = \"import gc, torch\\n\" + code_recon + \"\\ngc.collect()\\ntorch.cuda.empty_cache()\\n\"\n    open(recon_path, \"w\", encoding=\"utf-8\").write(code_recon)\n\nutils_p = os.path.join(u3d_dir, \"scripts/utils.py\")\nif os.path.exists(utils_p):\n    utils_code = open(utils_p, \"r\", encoding=\"utf-8\").read()\n    utils_code = re.sub(r'providers\\s*=\\s*\\[.*?\\]', 'providers = [\"CPUExecutionProvider\"]', utils_code, flags=re.DOTALL)\n    open(utils_p, \"w\", encoding=\"utf-8\").write(utils_code)\n\nprint(\"=== [7/8] Tünel ve Sunucu Başlatılıyor ===\")\ncf_bin = f\"{WORK_DIR}/cloudflared\"\nif not os.path.exists(cf_bin):\n    subprocess.run([\"wget\", \"-q\", \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\", \"-O\", cf_bin], check=True)\n    subprocess.run([\"chmod\", \"+x\", cf_bin], check=True)\n\ncf_log_path = f\"{WORK_DIR}/cf.log\"\nsubprocess.Popen([cf_bin, \"tunnel\", \"--url\", \"http://127.0.0.1:7860\"], stdout=open(cf_log_path, \"w\"), stderr=subprocess.STDOUT)\ntime.sleep(3)\n\nenv_vars = os.environ.copy()\nenv_vars[\"PYTHONPATH\"] = u3d_dir\nenv_vars[\"PYTHONUNBUFFERED\"] = \"1\"\n\ngradio_log_path = f\"{WORK_DIR}/gradio.log\"\nproc = subprocess.Popen([sys.executable, \"-u\", \"gradio_app.py\"], cwd=u3d_dir, env=env_vars, stdout=open(gradio_log_path, \"w\"), stderr=subprocess.STDOUT)\n\nprint(\"=== [8/8] Modeller GPU'ya Yükleniyor (2-3 Dakika Sürebilir) ===\")\nwhile True:\n    if os.path.exists(gradio_log_path):\n        icerik = open(gradio_log_path, \"r\", errors=\"ignore\").read()\n        satirlar = icerik.strip().split('\\n')\n        if len(satirlar) > 0: print(f\"\\r⏳ Son işlem: {satirlar[-1][:120]:<120}\", end=\"\")\n        if \"Running on local URL\" in icerik or \"7860\" in icerik:\n     